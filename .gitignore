# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.vscode/

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# tauri build/state
src-tauri/target/
src-tauri/gen/
src-tauri/*.sqlite3
src-tauri/*.redb
src-tauri/*.redb.lock

# Claude Code runtime files — ignore all, but version the shared workflow tooling
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
!.claude/agents/
!.claude/rules/
!.claude/workflows/

# design-sync (claude.ai/design) — transient build/verification state
.ds-sync/
ds-bundle/
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.design-sync/ds-types/
.design-sync/*.log
.claude/SESSION_TITLE

# Email live-test credentials (EM-1 imap_live harness — MODUO_TEST_IMAP_CREDS_PATH)
*.creds.json
*.imap-creds.json

# Personal layer — private workflow notes, never committed (see AGENTS.md §Personal layer)
docs/local/

# Tool/agent run-state and stray build artifacts
.omo/
main.mjs

# backups of configs (they tend to hold secrets)
*.backup

# desktop keychain fallback files (local login sessions — never commit)
src-tauri/.moduo_keychain_*
