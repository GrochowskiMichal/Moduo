# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# IDE
.vscode/

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# tauri build/state
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
apps/desktop/src-tauri/*.sqlite3
apps/desktop/src-tauri/*.redb
apps/desktop/src-tauri/*.redb.lock

# Supabase CLI per-machine state (update-check cache, `supabase link` output) — see docs/gotchas/supabase.md
supabase/.temp/

# Claude Code runtime files — ignore all, but version the shared workflow tooling
.claude/*
!.claude/skills/
!.claude/commands/
!.claude/hooks/
!.claude/settings.json
!.claude/settings.lane.json
!.claude/sandbox/
!.claude/agents/
!.claude/rules/
!.claude/workflows/

# design-sync (claude.ai/design) — transient build/verification state
.ds-sync/
ds-bundle/
.design-sync/sb-reference/
.design-sync/learnings/
.design-sync/.cache/
.design-sync/node_modules
.design-sync/ds-types/
.design-sync/*.log
.claude/SESSION_TITLE
# The Moduo task this worktree's agent claimed (moduo-agent skill, moduo-report.sh)
.claude/MODUO_TASK
# /ship's one-time release approvals (guard-release.sh), never committed
.claude/release-approved/

# Email live-test credentials (EM-1 imap_live harness — MODUO_TEST_IMAP_CREDS_PATH)
*.creds.json
*.imap-creds.json

# Personal layer — private workflow notes, never committed (see AGENTS.md §Personal layer)
docs/local/

# Tool/agent run-state and stray build artifacts
.omo/
main.mjs

# backups of configs (they tend to hold secrets)
*.backup

# desktop keychain fallback files (local login sessions — never commit)
apps/desktop/src-tauri/.moduo_keychain_*

# Cursor is not part of the harness (decisions/workflow.md, 2026-10-07)
.cursor/

# Local Edge Function secrets (template: supabase/functions/.env.example)
supabase/functions/.env

# Playwright run output (e2e and visual)
test-results/
playwright-report/

# Turborepo local cache
.turbo/
.wrangler/

# Storybook static build (bun run build-storybook)
storybook-static/

# Deno writes a lock wherever it runs; the real one is supabase/functions/deno.lock.
/deno.lock

# Product lab dossiers (/product-lab, /product-jury): screenshots of seeded data, never source.
.lab/
