{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.sh\" \"Claude Code\" \"Needs your input\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code post-task'"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "asyncRewake": true,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-design-tokens.sh\""
          },
          {
            "type": "command",
            "asyncRewake": true,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-ast.sh\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "asyncRewake": true,
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-ast.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code pre-task'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-release.sh\"",
            "timeout": 30,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-secrets.sh\"",
            "timeout": 120,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-glob.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|mcp__.*__(apply_migration|execute_sql|deploy_edge_function)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-prod-db.sh\"",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-lane.sh\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|mcp__.*__(apply_migration|execute_sql|deploy_edge_function)",
        "hooks": [
          {
            "type": "command",
            "async": true,
            "timeout": 40,
            "command": "bun \"${CLAUDE_PROJECT_DIR}/scripts/agent/risk-hook.ts\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code session-end'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-title.sh\""
          },
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then printf \"%s\\n\" \"{\\\"systemMessage\\\":\\\"\\\\n\\\\nEntire CLI is enabled but not installed or not on PATH.\\\\nInstallation guide: https://docs.entire.io/cli/installation#installation-methods\\\"}\"; exit 0; fi; exec entire hooks claude-code session-start'"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/claude-plugins/moduo-agent/hooks/moduo-report.sh\" SessionStart"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/notify.sh\" \"Claude Code\" \"Block finished — ready for your review\""
          },
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code stop'"
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/tools/claude-plugins/moduo-agent/hooks/moduo-report.sh\" Stop"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'if ! command -v entire >/dev/null 2>&1; then exit 0; fi; exec entire hooks claude-code user-prompt-submit'"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "timeout": 5,
            "command": "sh -c 'command -v bun >/dev/null 2>&1 && bun \"${CLAUDE_PROJECT_DIR}/scripts/agent/router.ts\" 2>/dev/null; exit 0'"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(bun run verify)",
      "Bash(bun run verify *)",
      "Bash(bun run db:test)",
      "Bash(bun run db:test *)",
      "Bash(bun run lint:notes)",
      "Bash(bun run lint:tw)",
      "Bash(bun run lint:boundaries)",
      "Bash(bun run lint:css)",
      "Bash(bun run lint:js)",
      "Bash(bun run test)",
      "Bash(bun run test *)",
      "Bash(bun fmt --check)",
      "Bash(bun fmt --check *)",
      "Bash(bun lint)",
      "Bash(supabase status)",
      "Bash(supabase status *)",
      "Bash(npm view *)",
      "Bash(gh run watch *)",
      "mcp__moduo__tasks_search",
      "mcp__moduo__tasks_get",
      "mcp__moduo__tasks_list",
      "mcp__moduo__statuses_list",
      "mcp__moduo__projects_list",
      "mcp__moduo__sections_list",
      "mcp__Claude_Browser__find",
      "mcp__Claude_Browser__read_console_messages",
      "mcp__Claude_Browser__get_page_text",
      "mcp__Claude_Browser__read_network_requests",
      "mcp__supabase__list_edge_functions",
      "mcp__supabase__search_docs"
    ],
    "deny": [
      "Read(./.entire/metadata/**)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Bash(supabase db reset:*)",
      "Bash(supabase stop --no-backup:*)"
    ],
    "ask": [
      "Bash(az deployment group create*)",
      "Bash(az deployment sub create*)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "claude-security@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "mattpocock-skills@claude-plugins-official": true,
    "postgres-best-practices@supabase-agent-skills": true,
    "supabase@supabase-agent-skills": true,
    "ts7-lsp@moduo-local": true
  },
  "extraKnownMarketplaces": {
    "supabase-agent-skills": {
      "source": {
        "source": "github",
        "repo": "supabase/agent-skills"
      }
    },
    "moduo-local": {
      "source": {
        "source": "github",
        "repo": "GrochowskiMichal/Moduo"
      }
    }
  }
}
