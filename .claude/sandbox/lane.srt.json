{
  "$comment": "srt profile for unattended lanes (HV-1, AC6). scripts/agent/lane.sh resolves the relative paths against the worktree, adds the repository's git directory to allowWrite and the TURBO_API host to allowedDomains, then runs Claude Code in bypass mode inside it. Anything not listed fails loudly with its host name.",
  "network": {
    "allowedDomains": [
      "api.anthropic.com",
      "claude.ai",
      "platform.claude.com",
      "console.anthropic.com",
      "statsig.anthropic.com",
      "mcp.moduo.app",
      "registry.npmjs.org",
      "github.com",
      "api.github.com",
      "codeload.github.com",
      "objects.githubusercontent.com",
      "raw.githubusercontent.com",
      "127.0.0.1:54321",
      "127.0.0.1:54322",
      "127.0.0.1:54323",
      "127.0.0.1:54324",
      "127.0.0.1:8081",
      "127.0.0.1:6006"
    ],
    "deniedDomains": [],
    "allowLocalBinding": true
  },
  "filesystem": {
    "denyRead": [
      "~/.ssh",
      "~/.aws",
      "~/.config/gcloud",
      ".env",
      ".env.local"
    ],
    "allowWrite": [
      ".",
      "/tmp",
      "/private/tmp",
      "/private/var/folders",
      "~/.bun/install/cache",
      "~/.cache",
      "~/.claude",
      "~/Library/Caches"
    ],
    "denyWrite": [
      ".env",
      ".env.local",
      ".claude/settings.json",
      ".claude/settings.local.json",
      ".claude/settings.lane.json",
      ".claude/hooks",
      ".claude/sandbox",
      ".git/hooks",
      "~/.claude/settings.json",
      ".mcp.json",
      "~/.claude/settings.local.json",
      "~/.claude/hooks",
      "~/.claude/CLAUDE.md",
      "~/.claude/agents",
      "~/.claude/commands",
      "~/.claude/skills",
      "~/.claude/plugins",
      "~/.bun/bin",
      "~/.cache/pre-commit",
      "~/.cache/ms-playwright",
      "~/.cache/puppeteer",
      "~/.claude.json"
    ]
  }
}
