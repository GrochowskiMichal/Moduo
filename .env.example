APPLE_SIGNING_IDENTITY=Apple Development

# Market data APIs
PUBLIC_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
PUBLIC_FINNHUB_API_KEY=your_finnhub_key
PUBLIC_MARKETSTACK_API_KEY=your_marketstack_key

# Supabase moduohyb (https://supabase.com -> Settings -> API)
PUBLIC_SUPABASE_URL=https://wtoonrvuqumihpkbvwvs.supabase.co
PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
MODUO_SUPABASE_URL=https://wtoonrvuqumihpkbvwvs.supabase.co

# Deployed web origin for public "publish to web" share links (/p/<token>).
# On web builds, window.location.origin is used when this is empty. Desktop
# builds should set it to the deployed web app so shared links resolve.
PUBLIC_WEB_ORIGIN=

# Desktop app settings
MODUO_KEYCHAIN_SERVICE="com.moduo.desktop.auth"
MODUO_CALENDAR_GOOGLE_CLIENT_ID=""
MODUO_CALENDAR_GOOGLE_CLIENT_SECRET=""
MODUO_CALENDAR_MICROSOFT_CLIENT_ID=""
MODUO_ZOOM_CLIENT_ID=""
MODUO_ZOOM_CLIENT_SECRET=""
MODUO_GOOGLE_MEET_CLIENT_ID=""
MODUO_GOOGLE_MEET_CLIENT_SECRET=""
# openssl rand -hex 32 — MUST match TOKEN_ENCRYPTION_SECRET in moduo_landing/.env.local
MODUO_TOKEN_ENCRYPTION_SECRET=""

# Stripe (test mode) — publishable key for Stripe.js if needed; Price IDs for display / landing only.
# Checkout and trials use Supabase Edge Function secrets STRIPE_PRICE_* (must be price_… ids in the SAME Stripe account + mode as STRIPE_SECRET_KEY).
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_...
PUBLIC_STRIPE_PRICE_PRO_YEARLY=price_...
PUBLIC_STRIPE_PRICE_TEAM_MONTHLY=price_...
PUBLIC_STRIPE_PRICE_TEAM_YEARLY=price_...

# Supabase Edge Functions (set in Supabase Dashboard → Project Settings → Edge Functions → Secrets, not in this file):
# STRIPE_SECRET_KEY — sk_test_... (server only)
# STRIPE_WEBHOOK_SECRET — whsec_... from Stripe → Developers → Webhooks → your endpoint → Signing secret
# STRIPE_PRICE_PRO_MONTHLY / PRO_YEARLY / TEAM_MONTHLY / TEAM_YEARLY / STRIPE_PRICE_FOUNDERS — same price_... IDs as above (webhook maps price → plan tier)
