{
  "name": "@moduo/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "MODUO_TARGET=web rsbuild dev --host 127.0.0.1 --port 8081",
    "dev:desktop": "MODUO_TARGET=desktop rsbuild dev --host 127.0.0.1 --port 8081",
    "preview": "MODUO_TARGET=web rsbuild preview --host 127.0.0.1 --port 8081",
    "build": "MODUO_TARGET=web rsbuild build",
    "build:desktop": "MODUO_TARGET=desktop rsbuild build",
    "typecheck": "tsc-ts --noEmit",
    "lint:tw": "bun ../../scripts/check-arbitrary-tw.ts",
    "lint:boundaries": "bun ../../scripts/check-boundaries.ts",
    "lint:css": "stylelint \"src/**/*.css\"",
    "size": "MODUO_TARGET=web rsbuild build && bun ../../scripts/check-bundle-size.ts",
    "test": "rstest",
    "test:watch": "rstest --watch"
  },
