// The web app on Cloudflare Workers static assets (specs/platform-v2.md, PLAT-4).
// Deployed by .github/workflows/app-preview.yml (a version per PR, on the staging Worker) and
// app-staging.yml (staging, after checks pass on develop); wrangler is pinned there. Production
// is deployed by _deploy-web.yml (release.yml / deploy-prod.yml) as a canary: a version upload
// moved to 100% by scripts/release/canary.ts (HV-28). Never add CANARY_FORCE_ERROR_AFTER here:
// only canary-rehearsal.yml sets it, on a staging version.
//
// One build serves every environment. The edge Worker (edge/worker.ts) runs for HTML navigations,
// /config.json and missing files, and writes the environment's vars below into the page as
// window.__MODUO_CONFIG__. Every var here is public (it ships to every browser); never put a
// secret in vars.
//
// Routing: a file that exists is served without the Worker. The Worker runs for "/" and
// "/index.html" (run_worker_first: they are files, but need the config injected) and for any path
// with no file: app routes get the shell, /config.json the config, a missing /static/* file a 404.
// not_found_handling stays "none" on purpose: "single-page-application" answers a missing
// /static/* file with the shell (and its immutable header) before the Worker can run.
{
  "name": "moduo-app",
  "main": "edge/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/", "/index.html"]
  },
  "observability": { "enabled": true },
  "env": {
    // Previews are versions of this Worker (`wrangler versions upload --preview-alias pr-<n>`),
    // so they share its config and talk to the same Supabase project. Served at
    // app.staging.moduo.app (a custom domain: wrangler creates its DNS record and certificate) and
    // still at https://moduo-app-staging.moduo.workers.dev, which the preview aliases need.
    "staging": {
      "name": "moduo-app-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [{ "pattern": "app.staging.moduo.app", "custom_domain": true }],
      "vars": {
        "SUPABASE_URL": "https://wtoonrvuqumihpkbvwvs.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_NAVl-rzFzPOi5ZU84aC3pA_SOIR00so",
        "WEB_ORIGIN": "https://app.staging.moduo.app",
        "STAGING_PORTAL": "true"
      }
    },
    // app.moduo.app, deployed only by deploy-prod.yml. PostHog, Stripe and VAPID keys are added
    // here when they are set for prod (the Vercel prod build had none of them).
    "production": {
      "name": "moduo-app-production",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "app.moduo.app", "custom_domain": true }],
      "vars": {
        "SUPABASE_URL": "https://wtoonrvuqumihpkbvwvs.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_NAVl-rzFzPOi5ZU84aC3pA_SOIR00so",
        "WEB_ORIGIN": "https://app.moduo.app"
      }
    }
  }
}
