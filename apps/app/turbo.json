{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/release-notes/**"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/release-notes/**",
        "$TURBO_ROOT$/supabase/functions/_shared/**",
        "$TURBO_ROOT$/scripts/**"
      ]
    },
    "lint:tw": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-arbitrary-tw.ts"]
    },
    "lint:boundaries": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/check-boundaries*.ts"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/supabase/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/e2e/tests/fixtures/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/VERSION",
        "$TURBO_ROOT$/release-notes/**"
      ]
    }
  }
}
