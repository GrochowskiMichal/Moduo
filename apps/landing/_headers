# Response headers for the landing's files (apps/landing/wrangler.jsonc); build.mjs copies this
# into dist. /book and /static/* come from the app Worker with its own headers. HTML keeps the
# static-assets default (public, max-age=0, must-revalidate), so a deploy shows at once.
# CSP is report-only until Phase 3: the pages use inline scripts and styles, PostHog,
# jsDelivr fonts and the waitlist function on Supabase.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://eu-assets.i.posthog.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data: https://cdn.jsdelivr.net; media-src 'self' https:; connect-src 'self' https://*.supabase.co https://eu.i.posthog.com https://eu-assets.i.posthog.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000

# Not content-hashed, so cached for a day, then revalidated in the background.
/assets/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
