{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/src/**",
        "$TURBO_ROOT$/apps/app/tsconfig.json",
        "$TURBO_ROOT$/supabase/functions/_shared/**"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/src/**",
        "$TURBO_ROOT$/apps/app/public/**"
      ],
      "outputs": ["storybook-static/**"]
    }
  }
}
