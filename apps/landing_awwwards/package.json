{
  "name": "@moduo/landing-awwwards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1 --port 4321",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:preview": "ASTRO_TELEMETRY_DISABLED=1 PUBLIC_NOINDEX=1 astro build",
    "og": "ASTRO_TELEMETRY_DISABLED=1 OG=1 astro build --outDir .og-build && node scripts/og.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1 --port 4400",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "rstest"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "astro": "7.4.2",
    "earcut": "3.0.1",
    "gsap": "3.15.0",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@tanstack/devtools": "0.15.0",
    "axe-core": "^4.14.0",
    "playwright": "^1.63.0"
  }
}
