---
// Three steps, each with the screen you do it on: Moduo's connector card in Settings, your
// assistant's own "add a connector" form (drawn plain, as no one app in particular), and Moduo's
// sign-in page where you choose the reach. Then the key, for scripts that can't sign in.
import "../../styles/frames.css";
import Btn from "../Btn.astro";
import Code from "../page/Code.astro";
import Head from "../page/Head.astro";
import Icon from "../frames/Icon.astro";
import { ai } from "../../data/pages/ai";

const c = ai.connect;
const consent = [
  ["Tasks", "Edit"],
  ["Notes", "Edit"],
  ["Calendar", "View"],
  ["Email", "View"],
] as const;
---

<section class="conn pg pg--chapter" id="connect" aria-labelledby="connect-title">
  <div class="wrap">
    <Head id="connect-title" title={c.title} text={c.text} />
    <ol class="conn__steps">
      <li class="conn__step" data-reveal>
        <span class="conn__n tabular" aria-hidden="true">1</span>
        <h3 class="conn__t">{c.steps[0].title}</h3>
        <p class="conn__d muted">{c.steps[0].text}</p>
        <div class="ap conn__pic" aria-hidden="true">
          <div class="ap-panel conn__card">
            <p class="ap-med">Connector</p>
            <p class="ap-muted ap-xs conn__lead">Add Moduo as a connector in Claude, ChatGPT or Claude Code with this URL. You’ll sign in and choose what it can reach.</p>
            <span class="conn__field is-mono">https://mcp.moduo.app</span>
            <span class="ap-btn ap-btn--secondary conn__btn"><Icon name="link-2" class="ap-i--sm" />Copy connector URL</span>
          </div>
        </div>
      </li>
      <li class="conn__step" data-reveal data-delay="0.08">
        <span class="conn__n tabular" aria-hidden="true">2</span>
        <h3 class="conn__t">{c.steps[1].title}</h3>
        <p class="conn__d muted">{c.steps[1].text}</p>
        <div class="ap conn__pic" aria-hidden="true">
          <div class="ap-panel conn__card">
            <p class="ap-med">Add custom connector</p>
            <span class="conn__lbl ap-xs ap-muted">Name</span>
            <span class="conn__field">Moduo</span>
            <span class="conn__lbl ap-xs ap-muted">Server URL</span>
            <span class="conn__field is-mono is-on">https://mcp.moduo.app<span class="ap-caret"></span></span>
            <span class="ap-btn ap-btn--primary conn__btn">Add</span>
          </div>
        </div>
      </li>
      <li class="conn__step" data-reveal data-delay="0.16">
        <span class="conn__n tabular" aria-hidden="true">3</span>
        <h3 class="conn__t">{c.steps[2].title}</h3>
        <p class="conn__d muted">{c.steps[2].text}</p>
        <div class="ap conn__pic" aria-hidden="true">
          <div class="ap-panel conn__card">
            <p class="ap-med">Claude wants to work in Moduo as you</p>
            <p class="ap-xs ap-muted">Returns to <span class="conn__mono">claude.ai</span></p>
            <span class="conn__lbl ap-xs ap-muted">Workspace</span>
            <span class="conn__field">Moduo<Icon name="chevron-down" class="ap-i--xs" /></span>
            <ul class="conn__levels">
              {
                consent.map(([m, l]) => (
                  <li>
                    <span>{m}</span>
                    <span class="ap-seg">
                      {["None", "View", "Edit"].map((x) => (
                        <span class:list={[x === l && "is-on"]}>{x}</span>
                      ))}
                    </span>
                  </li>
                ))
              }
            </ul>
            <span class="conn__acts"><span class="ap-btn ap-btn--ghost">Deny</span><span class="ap-btn ap-btn--primary">Approve</span></span>
          </div>
        </div>
      </li>
    </ol>
    <div class="conn__keys grid">
      <p class="conn__scripts muted" data-reveal>{c.scripts}</p>
      <div class="conn__code" data-reveal>
        <Code label={c.headerLabel} code={c.header} inline />
        <Btn variant="ghost" href="/mcp#keys" arrow>{ai.docs}</Btn>
      </div>
    </div>
  </div>
</section>

<style>
  .conn__steps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    counter-reset: none;
  }
  .conn__step {
    position: relative;
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    align-content: start;
    gap: 0.625rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line-strong);
  }
  .conn__n {
    font-size: var(--t-xs);
    font-weight: var(--w-ui);
    color: var(--c-quiet);
  }
  .conn__t {
    font-size: var(--t-m);
    letter-spacing: var(--tr-m);
    font-weight: var(--w-ui);
  }
  .conn__d {
    max-width: 30ch;
    min-height: 3.1em;
  }
  .conn__pic {
    margin-top: 1.25rem;
    font-size: clamp(12px, 3.4cqi, 14px);
  }
  .conn__card {
    display: grid;
    gap: 0.571em;
    padding: 1.143em;
    background: #0b0b0b;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 1.5em 3em -1.5em rgb(0 0 0 / 0.9);
  }
  .conn__lead {
    line-height: 1.5;
  }
  .conn__lbl {
    margin-top: 0.286em;
  }
  .conn__field {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5em;
    min-height: 2.286em;
    padding: 0 0.714em;
    border-radius: 0.571em;
    background: var(--ap-muted-bg);
    box-shadow: inset 0 0 0 1px var(--ap-line);
    font-size: 0.929em;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }
  .conn__field.is-mono {
    font-family: "Geist Mono", ui-monospace, monospace;
  }
  .conn__field.is-on {
    justify-content: flex-start;
    box-shadow: inset 0 0 0 1px var(--ap-sel-edge);
  }
  .conn__mono {
    font-family: "Geist Mono", ui-monospace, monospace;
  }
  .conn__btn {
    justify-self: start;
    margin-top: 0.286em;
  }
  .conn__levels {
    display: grid;
    margin-top: 0.286em;
  }
  .conn__levels li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.286em;
    border-bottom: 1px solid var(--ap-line);
    font-size: 0.929em;
  }
  .conn__acts {
    display: flex;
    justify-content: flex-end;
    gap: 0.429em;
    margin-top: 0.571em;
  }
  .conn__keys {
    margin-top: calc(var(--u) * 7);
    row-gap: 1.25rem;
    align-items: start;
  }
  .conn__scripts {
    grid-column: 1 / span 4;
    max-width: 30rem;
  }
  .conn__code {
    grid-column: 5 / span 5;
    display: grid;
    justify-items: start;
    gap: 1rem;
    min-width: 0;
  }
  .conn__code :global(.code) {
    width: 100%;
  }
  @media (max-width: 1000px) {
    .conn__steps {
      grid-template-columns: 1fr;
      row-gap: 3rem;
      max-width: 34rem;
    }
    .conn__d {
      min-height: 0;
    }
    .conn__scripts,
    .conn__code {
      grid-column: 1 / -1;
    }
    .conn__code {
      max-width: 34rem;
    }
  }
</style>
