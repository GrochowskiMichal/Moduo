---
// Revoke: the workspace's AI keys, each with what it can reach, and the old one taken back (its
// row strikes through when it comes into view, motion/bento.ts; the still picture is revoked).
import "../../styles/frames.css";
import Icon from "../frames/Icon.astro";

const keys = [
  { n: "Mike’s agent", s: "Edit: Tasks, Notes · View: Email", used: "Used 2 min ago" },
  { n: "Maciej’s agent", s: "View: Calendar, Contacts", used: "Used yesterday" },
  { n: "Local model", s: "View: Notes", used: "Used Mon" },
] as const;
---

<div class="ap mini rm" aria-hidden="true" data-mini="revoke">
  <div class="ap-panel rm-panel">
    <div class="rm-head">
      <span class="ap-med">AI keys</span>
      <span class="ap-xs ap-muted">4 keys</span>
    </div>
    {
      keys.map((k) => (
        <div class="rm-row">
          <span class="rm-ic">
            <Icon name="key-round" class="ap-i--sm" />
          </span>
          <span class="grow">
            <span class="rm-n">{k.n}</span>
            <span class="rm-s ap-ell">{k.s}</span>
          </span>
          <span class="ap-btn ap-btn--outline rm-btn">Revoke</span>
        </div>
      ))
    }
    <div class="rm-row is-gone" data-gone>
      <span class="rm-ic">
        <Icon name="key-round" class="ap-i--sm" />
      </span>
      <span class="grow">
        <span class="rm-n"><span class="rm-strike" data-strike></span>Old laptop script</span>
        <span class="rm-s ap-ell">Edit: Tasks · Used in May</span>
      </span>
      <span class="rm-badge" data-badge>Revoked</span>
    </div>
  </div>
</div>

<style>
  .rm {
    left: 50%;
    top: 0;
    width: min(90%, 25em);
    translate: -50% 0;
  }
  .rm-panel {
    padding: 0.857em 1em 0.571em;
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 2em 3em -1.5em rgb(0 0 0 / 0.9);
  }
  .rm-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding-bottom: 0.714em;
  }
  .rm-row {
    display: flex;
    align-items: center;
    gap: 0.714em;
    min-height: 3.143em;
    border-top: 1px solid var(--ap-line);
  }
  .rm-ic {
    display: grid;
    place-items: center;
    width: 2em;
    height: 2em;
    border-radius: 0.571em;
    box-shadow: inset 0 0 0 1px var(--ap-hairline);
    color: var(--ap-muted);
  }
  .rm-n,
  .rm-s {
    display: block;
  }
  .rm-n {
    font-size: 0.929em;
    font-weight: 500;
  }
  .rm-s {
    color: var(--ap-muted);
    font-size: 0.786em;
  }
  .rm-btn {
    height: 1.714em;
    font-size: 0.857em;
  }
  .rm-row.is-gone .rm-n {
    position: relative;
    width: fit-content;
    color: var(--ap-muted);
  }
  /* The strike is a line of its own, so it can be drawn across. */
  .rm-strike {
    position: absolute;
    left: -0.1em;
    right: -0.1em;
    top: 55%;
    height: 1px;
    background: rgb(250 250 250 / 0.6);
    transform-origin: 0 50%;
  }
  .rm-row.is-gone .rm-ic {
    opacity: 0.5;
  }
  .rm-badge {
    display: inline-flex;
    align-items: center;
    height: 1.714em;
    padding: 0 0.571em;
    border-radius: 0.429em;
    background: var(--ap-primary);
    color: var(--ap-primary-fg);
    font-size: 0.857em;
    font-weight: 500;
  }
</style>
