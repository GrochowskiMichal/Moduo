---
// Import: two ways in, drawn as a wiring diagram. Notion and Markdown pages become notes, a CSV
// becomes contacts; a pulse runs along each wire now and then (motion/bento.ts).
import "../../styles/frames.css";
import { MARK } from "../../lib/brand";
import Icon from "../frames/Icon.astro";

const routes = [
  { from: "Notion export", icon: "file-text", to: "Notes", toIcon: "file-text", note: "Pages, with their links" },
  { from: "contacts.csv", icon: "sheet", to: "Contacts", toIcon: "contact", note: "Matched to your email" },
] as const;
---

<div class="ap mini im" aria-hidden="true" data-mini="import">
  {
    routes.map((r) => (
      <div class="im-route">
        <span class="im-tile">
          <Icon name={r.icon} />
          <span class="im-cap ap-xs">{r.from}</span>
        </span>
        <span class="im-wire">
          <i data-pulse />
          <span class="im-chip">
            <svg viewBox={MARK.tight}>
              <path d={MARK.d} fill="currentColor" fill-rule="evenodd" />
            </svg>
          </span>
        </span>
        <span class="im-tile is-to">
          <Icon name={r.toIcon} />
          <span class="im-cap ap-xs">{r.to}</span>
        </span>
        <span class="im-note ap-xs ap-muted">{r.note}</span>
      </div>
    ))
  }
</div>

<style>
  .im {
    left: 50%;
    top: 0.5em;
    width: min(92%, 34em);
    translate: -50% 0;
    display: grid;
    gap: 1.714em;
  }
  /* In a phone's cell the diagram keeps the words' inset from the hairlines. */
  @container (max-width: 25rem) {
    .im {
      width: calc(100% - 2.5rem);
    }
  }
  .im-route {
    display: grid;
    grid-template-columns: 5.714em 1fr 5.714em;
    align-items: center;
    row-gap: 0.571em;
  }
  .im-tile {
    position: relative;
    display: grid;
    place-items: center;
    width: 5.714em;
    height: 5.714em;
    border-radius: 0.857em;
    background: linear-gradient(#141414, #0a0a0a);
    box-shadow:
      inset 0 0 0 1px var(--ap-line),
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 1.5em 2em -1em rgb(0 0 0 / 0.8);
    color: var(--ap-muted);
  }
  .im-tile :global(.ap-i) {
    width: 1.714em;
    height: 1.714em;
    stroke-width: 1.6;
  }
  .im-tile.is-to {
    color: var(--ap-fg);
    box-shadow:
      inset 0 0 0 1px var(--ap-line-strong),
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      0 1.5em 2em -1em rgb(0 0 0 / 0.8);
  }
  .im-cap {
    position: absolute;
    top: calc(100% + 0.6em);
    white-space: nowrap;
    color: var(--ap-muted);
  }
  .im-tile.is-to .im-cap {
    color: var(--ap-fg);
  }
  .im-wire {
    position: relative;
    display: grid;
    place-items: center;
    height: 1px;
    margin: 0 0.571em;
    background: var(--ap-line-strong);
  }
  .im-wire i {
    position: absolute;
    left: 0;
    top: -0.143em;
    width: 2.857em;
    height: 0.286em;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.9), transparent);
    opacity: 0;
  }
  .im-chip {
    display: grid;
    place-items: center;
    width: 2.571em;
    height: 2.571em;
    border-radius: 0.714em;
    background: #0b0b0b;
    box-shadow:
      inset 0 0 0 1px var(--ap-line-strong),
      inset 0 1px 0 rgb(255 255 255 / 0.08);
    color: var(--ap-fg);
  }
  .im-chip svg {
    width: 1.286em;
    height: 1em;
  }
  .im-note {
    grid-column: 1 / -1;
    margin-top: 1.429em;
    text-align: center;
  }
</style>
