---
// The Tasks card's picture: Focus, the app's one-thing-at-a-time screen, drawn at the moment a task
// is finished. Done ⏎ goes down on the task in hand; the minutes its clock kept lift off the pill
// and land on it in the done list ("38m of ~45m"); the next task rises out of Up next into its
// place and its clock starts; the line-up and the day's total follow (motion/bento.ts plays it;
// the still picture is the result). The sums are the picture's own: Up next was 20 + 10 + 40 min,
// the done list 60 + 12 before and 38 more after.
import "../../styles/frames.css";
import Icon from "../frames/Icon.astro";
---

<div class="ap mini tm" aria-hidden="true" data-mini="tasks">
  <div class="ap-panel tm-panel">
    <div class="tm-card">
      <div class="tm-stage">
        <div class="tm-task" data-was>
          <p class="tm-meta">
            <span class="ap-proj grow ap-ell"><span class="ap-dot" style="--c:var(--ap-blue)"></span>Open alpha · Due today</span>
            <span class="tm-pill"><Icon name="pause" class="ap-i--xs" /><span data-mins>38:12</span> <span class="ap-muted">of ~45m</span></span>
          </p>
          <p class="tm-title ap-ell">Pick the first wave</p>
        </div>
        <div class="tm-task" data-is>
          <p class="tm-meta">
            <span class="ap-proj grow ap-ell"><span class="ap-dot" style="--c:var(--ap-blue)"></span>Open alpha · Due 14:00</span>
            <span class="tm-pill"><Icon name="pause" class="ap-i--xs" /><span data-run>4:18</span> <span class="ap-muted">of ~20m</span></span>
          </p>
          <p class="tm-title ap-ell">Review the open alpha invite</p>
        </div>
      </div>
      <p class="tm-actions">
        <span class="ap-btn ap-btn--primary" data-done>Done <span class="ap-kbd" data-key>⏎</span></span>
        <span class="ap-btn ap-btn--secondary">Skip <span class="ap-kbd">S</span></span>
      </p>
      <span class="tm-fly" data-fly>38m</span>
    </div>

    <div class="tm-list">
      <p class="tm-row tm-hd">
        <span class="tm-swap ap-ell">
          <span data-a>Up next <span class="ap-muted">· 3 · ~1h 10m · ≈ 1h 25m at your usual pace</span></span>
          <span data-b>Up next <span class="ap-muted">· 2 · ~50m · ≈ 1h at your usual pace</span></span>
        </span>
      </p>
      <p class="tm-row" data-up>
        <span class="tm-n tm-swap"><span data-a>2</span><span data-b>1</span></span>
        <span class="grow ap-ell">Write the 1.4.1 notes</span>
        <span class="ap-meta">~10m</span>
      </p>
      <p class="tm-row" data-up>
        <span class="tm-n tm-swap"><span data-a>3</span><span data-b>2</span></span>
        <span class="grow ap-ell">Fix the Windows build</span>
        <span class="ap-meta">~40m</span>
      </p>
      <p class="tm-row tm-doneline" data-up>
        <span class="tm-swap"><span data-a>2 done · 1h 12m</span><span data-b>3 done · 1h 50m</span></span>
        <span>·</span>
        <span class="tm-hide">Hide</span>
      </p>
      <p class="tm-row tm-done" data-landed>
        <span class="ap-check is-done"></span>
        <span class="ap-ell ap-done-t">Pick the first wave</span>
        <span class="tm-kept" data-kept>38m</span>
        <span class="ap-meta">of ~45m</span>
      </p>
      <p class="tm-row tm-done">
        <span class="ap-check is-done"></span>
        <span class="ap-ell ap-done-t">Reply to Maciej</span>
        <span class="tm-kept">12m</span>
        <span class="ap-meta">of ~15m</span>
      </p>
      <p class="tm-row tm-done">
        <span class="ap-check is-done"></span>
        <span class="ap-ell ap-done-t">Read alpha feedback</span>
        <span class="tm-kept">1h</span>
        <span class="ap-meta">of ~30m</span>
      </p>
      <!-- The task that leaves Up next for the Now card: only seen while the moment plays. -->
      <p class="tm-row tm-ghost" data-leaves>
        <span class="tm-n">1</span>
        <span class="grow ap-ell">Review the open alpha invite</span>
        <span class="ap-meta">~20m</span>
      </p>
    </div>
  </div>
</div>

<style>
  /* The picture fills its room and runs on past the card's foot, fading out instead of slicing a
     row of the done list wherever the card's height happens to cut it. */
  .tm {
    left: 8%;
    top: 0;
    bottom: 0;
    width: 92%;
    -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 1.6em), transparent);
    mask-image: linear-gradient(to bottom, #000 calc(100% - 1.6em), transparent);
  }
  .tm-panel {
    padding: 0.857em 0.857em 0;
    border-bottom-right-radius: 0;
  }
  /* The card keeps room for the moment through its landing: the task the minutes land on stays
     whole and clear of the fade at every width (it ends 22.9em down the picture). */
  :global(.bcard__art:has(> [data-mini="tasks"])) {
    min-height: calc(var(--mini-fs) * 24);
  }
  /* The Now card, as the app draws it: the task's line, its clock, its title, Done and Skip. */
  .tm-card {
    position: relative;
    display: grid;
    gap: 0.857em;
    padding: 1.143em;
    border-radius: 0.857em;
    border: 1px solid var(--ap-line);
    background: var(--ap-card);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.04),
      0 1.143em 2.857em -1.429em rgb(0 0 0 / 0.8);
  }
  /* The task in hand and the one before it share a place; the still picture shows the new one. */
  .tm-stage {
    display: grid;
  }
  .tm-stage > * {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .tm-task {
    display: grid;
    gap: 0.571em;
  }
  .tm-meta {
    display: flex;
    align-items: center;
    gap: 0.571em;
  }
  .tm-pill {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.4em;
    height: 2.167em;
    padding: 0 0.667em;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--ap-hairline);
    font-size: 0.857em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .tm-title {
    font-size: 1.5em;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .tm-actions {
    display: flex;
    gap: 0.429em;
  }
  /* The minutes the clock kept, on their way from the pill to the task. */
  .tm-fly {
    position: absolute;
    top: 1.49em;
    right: 5.6em;
    display: inline-grid;
    place-items: center;
    height: 1.857em;
    padding: 0 0.571em;
    border-radius: 999px;
    background: var(--ap-primary);
    color: var(--ap-primary-fg);
    font-size: 0.857em;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    box-shadow:
      0 0 0 0.25em rgb(238 238 238 / 0.08),
      0 0.75em 1.5em -0.25em rgb(0 0 0 / 0.8);
    pointer-events: none;
  }
  /* Up next and what's done, on one row height, so a task leaving one and arriving in the other
     moves everything between by exactly a row. Each list's heading sits low in its row, close to
     the rows it heads; the done list stands a step apart from Up next. */
  .tm-list {
    --row: 2.143em;
    position: relative;
    display: grid;
    margin-top: 1.143em;
    padding: 0 0.286em;
  }
  .tm-row {
    display: flex;
    align-items: center;
    gap: 0.571em;
    height: var(--row);
    min-width: 0;
    font-size: 0.929em;
  }
  .tm-list .tm-row {
    height: calc(var(--row) / 0.929);
  }
  .tm-hd {
    align-items: flex-end;
    padding-bottom: 0.308em;
    font-weight: 500;
  }
  .tm-hd .ap-muted {
    font-weight: 400;
  }
  .tm-n {
    flex: none;
    width: 1.385em;
    color: var(--ap-subtle);
    font-size: 0.923em;
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .tm-doneline {
    gap: 0.4em;
    color: var(--ap-muted);
    font-size: 0.857em;
    font-variant-numeric: tabular-nums;
  }
  .tm-list .tm-doneline {
    align-items: flex-end;
    height: calc(var(--row) / 0.857);
    margin-top: 0.667em;
    padding-bottom: 0.333em;
  }
  .tm-hide {
    color: var(--ap-fg);
  }
  .tm-done .ap-check {
    width: 1.077em;
    height: 1.077em;
    margin: 0 0.154em;
  }
  /* A done task's minutes follow its title, written onto it, and leave the row's far end clear for
     the card's Open button. */
  .tm-kept {
    flex: none;
    font-size: 0.923em;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .tm-done .ap-meta {
    margin-left: -0.308em;
    font-size: 0.923em;
  }
  /* The done list recedes after the task the minutes just landed on. */
  .tm-done[data-landed] + .tm-done {
    opacity: 0.55;
  }
  .tm-done[data-landed] + .tm-done + .tm-done {
    opacity: 0.28;
  }
  /* The task that took the minutes, lit for a moment as they land. */
  .tm-done[data-landed] {
    margin: 0 -0.308em;
    padding: 0 0.308em;
    border-radius: 0.615em;
  }
  .tm-ghost {
    position: absolute;
    left: 0.286em;
    right: 0.286em;
    top: calc(var(--row) / 0.929);
  }
  /* Two states of one thing in one place: the still picture shows the second. */
  .tm-swap {
    display: inline-grid;
  }
  .tm-swap > * {
    grid-area: 1 / 1;
    min-width: 0;
  }
  .tm-swap.ap-ell > * {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  [data-a],
  [data-was],
  [data-leaves],
  [data-fly] {
    visibility: hidden;
  }
  /* Under reduced motion the moment never plays: its other half is not there at all, rather than
     laid out and unseen. */
  @media (prefers-reduced-motion: reduce) {
    [data-was],
    [data-leaves],
    [data-fly] {
      display: none;
    }
  }
</style>
