---
// The logo files as a ledger: each colorway on the ground it is made for (Paper on Canvas, Ink on
// white), with its SVG and PNG and their real sizes, read from public/press at build time. The
// app icon and the whole kit close the grid.
import fs from "node:fs";
import path from "node:path";

import { press } from "../../data/pages/press";

const f = press.files;
const dir = path.resolve("public/press");
// The SVG's own width and height, so the browser reserves its box before it loads.
const dims = (file: string) => {
  try {
    const head = fs.readFileSync(path.join(dir, file), "utf8").slice(0, 400);
    const w = head.match(/width="([\d.]+)"/)?.[1];
    const h = head.match(/height="([\d.]+)"/)?.[1];
    return w && h ? { width: Math.round(Number(w)), height: Math.round(Number(h)) } : {};
  } catch {
    return {};
  }
};
const size = (file: string) => {
  try {
    const b = fs.statSync(path.join(dir, file)).size;
    return b >= 1024 * 1024 ? `${(b / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`;
  } catch {
    return "";
  }
};
---

<div class="files">
  {
    f.items.map((it) => (
      <article class:list={["files__cell", `is-${it.on}`]} style={`--span:${it.span}`} aria-labelledby={`files-${it.id}`}>
        <div class:list={["files__art", `files__art--${it.name.toLowerCase()}`]}>
          <img src={`/press/${it.img}.svg`} alt={it.alt} {...dims(`${it.img}.svg`)} loading="lazy" decoding="async" />
        </div>
        <div class="files__bar">
          <h3 class="files__name" id={`files-${it.id}`}>
            {it.name} <span class="files__tone">{it.tone}</span>
          </h3>
          <p class="files__dl">
            <a class="link" href={`/press/${it.img}.svg`} download>
              SVG <span class="files__size">{size(`${it.img}.svg`)}</span>
            </a>
            <a class="link" href={`/press/${it.img}.png`} download>
              PNG <span class="files__size">{size(`${it.img}.png`)}</span>
            </a>
          </p>
        </div>
      </article>
    ))
  }
  <article class="files__cell is-dark files__icon" style="--span:6" aria-labelledby="files-icon">
    <div class="files__art files__art--icon">
      <img src={`/press/${f.icon.file}`} alt={f.icon.alt} width="1024" height="1024" loading="lazy" decoding="async" />
    </div>
    <div class="files__bar">
      <div>
        <h3 class="files__name" id="files-icon">{f.icon.name}</h3>
        <p class="files__note">{f.icon.text}</p>
      </div>
      <p class="files__dl">
        <a class="link" href={`/press/${f.icon.file}`} download>
          PNG <span class="files__size">{size(f.icon.file)}</span>
        </a>
      </p>
    </div>
  </article>
  <article class="files__cell is-dark files__kit" style="--span:6" aria-labelledby="files-kit">
    <div class="files__kit-in">
      <h3 class="files__kit-name t-m" id="files-kit">{f.kit.name}</h3>
      <p class="files__note">{f.kit.text}</p>
      <a class="btn files__kit-btn" href={press.kit.href} download data-sweep>
        <span class="btn__label">{press.cta.kit}</span>
        <span class="files__size">ZIP, {size(press.kit.file)}</span>
        <span class="btn__sweep" aria-hidden="true"></span>
      </a>
    </div>
  </article>
</div>
<p class="files__foot t-s quiet">{f.wordmarkNote}</p>

<style>
  .files {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-line-strong);
    box-shadow: 0 0 0 1px var(--c-line-strong);
  }
  .files__cell {
    grid-column: span var(--span);
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--c-bg);
  }
  .files__cell.is-light {
    background: var(--c-fg);
    color: var(--c-bg);
  }
  .files__art {
    display: grid;
    place-items: center;
    flex: 1;
    min-height: clamp(11rem, 18vw, 16rem);
    padding: 2.5rem;
  }
  .files__art img {
    display: block;
    height: auto;
  }
  .files__art--lockup img {
    width: min(70%, 22rem);
  }
  .files__art--mark img {
    width: min(55%, 7rem);
  }
  .files__art--wordmark img {
    width: min(70%, 11rem);
  }
  .files__art--icon img {
    width: clamp(6rem, 11vw, 9rem);
  }
  .files__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.5rem 1.25rem;
    padding: 1rem 1.25rem 1.125rem;
    border-top: 1px solid var(--c-line);
  }
  .is-light .files__bar {
    border-top-color: color-mix(in srgb, var(--c-bg) 12%, var(--c-fg));
  }
  .files__name {
    font-size: var(--t-s);
    font-weight: var(--w-ui);
  }
  .files__tone,
  .files__size {
    font-weight: var(--w-small);
    color: var(--c-quiet);
  }
  .is-light .files__tone,
  .is-light .files__size {
    color: color-mix(in srgb, var(--c-bg) 64%, var(--c-fg));
  }
  .files__dl {
    display: flex;
    gap: 1rem;
    font-size: var(--t-s);
    font-weight: var(--w-ui);
  }
  /* On a white cell the link's lines are ink. */
  .is-light .files__dl .link {
    background-image:
      linear-gradient(var(--c-bg), var(--c-bg)),
      linear-gradient(color-mix(in srgb, var(--c-bg) 45%, var(--c-fg)), color-mix(in srgb, var(--c-bg) 45%, var(--c-fg)));
  }
  .is-light .files__dl .link:focus-visible {
    outline-color: var(--c-bg);
  }
  .files__note {
    max-width: 30rem;
    margin-top: 0.25rem;
    font-size: var(--t-s);
    font-weight: var(--w-small);
    color: var(--c-muted);
  }
  .files__kit-in {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 0.75rem;
    height: 100%;
    padding: 1.25rem;
  }
  .files__kit-name {
    font-weight: var(--w-ui);
  }
  .files__kit-btn {
    margin-top: 0.75rem;
    gap: 0.75rem;
  }
  .files__kit-btn .files__size {
    color: inherit;
    opacity: 0.6;
  }
  .files__foot {
    margin-top: 1rem;
  }
  @media (max-width: 999px) {
    .files__cell {
      grid-column: span 6;
    }
    .files__icon,
    .files__kit {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .files__cell {
      grid-column: 1 / -1;
    }
    .files__art {
      min-height: 9.5rem;
      padding: 2rem;
    }
  }
</style>
