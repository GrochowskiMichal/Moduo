---
// The map: the four places your work lives, top to bottom, wired by exactly what crosses between
// them (brand §12 diagrams: hairlines and small dots, Paper and grey). Each place is a stroke on
// the line; Moduo's is the mark. Down the left a dashed bracket joins your mail provider to Moduo's
// servers and is cut in the middle: never connected. Beside it, "Follow": pick one thing and its
// path lights, and a dot runs it once (motion/pages/security.ts). Every word is on the page
// without JS or motion; the control only lights a path.
import StrokePair from "../StrokePair.astro";
import { MARK } from "../../lib/brand";
import { STROKE, STROKE_PATH } from "../../lib/stroke";
import { security } from "../../data/pages/security";

const m = security.map;
const strokeVb = `0 ${STROKE.top} ${STROKE.w} ${STROKE.bottom - STROKE.top}`;
const on = (kind: "places" | "wires", id: string) =>
  m.things
    .filter((t) => (t[kind] as readonly string[]).includes(id))
    .map((t) => t.id)
    .join(" ");
const placeName = (id: string) => m.places.find((p) => p.id === id)!.name;
---

<div class="smap-wrap grid" data-smap>
  <div class="sfol">
    <p class="sfol__k t-xs" id="sfol-k">{m.follow}</p>
    <ul class="sfol__list" aria-labelledby="sfol-k">
      {
        m.things.map((t) => (
          <li class="sfol__item" data-thing={t.id}>
            <h3 class="sfol__h">
              <button
                class="sfol__b"
                type="button"
                aria-pressed="false"
                aria-controls="smap"
                data-follow={t.id}
                data-path={t.places.join(" ")}
              >
                <StrokePair class="sfol__glyph" size="0.7rem" />
                <span class="sfol__n">{t.name}</span>
              </button>
            </h3>
            <p class="sfol__t">{t.text}</p>
          </li>
        ))
      }
    </ul>
  </div>

  <ol class="smap" id="smap" aria-label="Where your work lives, and what crosses between the places">
    {
      m.places.map((p, k) => (
        <>
          <li
            class="smap__place"
            data-place={p.id}
            data-on={on("places", p.id)}
            data-down={m.wires[k] ? on("wires", m.wires[k].id) : undefined}
          >
            <span class="smap__node" aria-hidden="true">
              {p.id === "moduo" ? (
                <svg class="smap__mark" viewBox={MARK.tight}>
                  <path d={MARK.d} fill-rule="evenodd" clip-rule="evenodd" />
                </svg>
              ) : (
                <svg class="smap__stroke" viewBox={strokeVb}>
                  <path d={STROKE_PATH} />
                </svg>
              )}
            </span>
            <div class="smap__info">
              <h3 class="smap__name">{p.name}</h3>
              <p class="smap__sub">{p.sub}</p>
              <ul class="smap__holds">
                {p.holds.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          </li>
          {m.wires[k] && (
            <li class="smap__wire" data-wire={m.wires[k].id} data-on={on("wires", m.wires[k].id)}>
              <span class="smap__line" aria-hidden="true">
                <i class="smap__dot" />
              </span>
              <p class="smap__cross">
                <span class="sr-only">
                  Between {p.name.toLowerCase()} and {placeName(m.places[k + 1].id).toLowerCase()}:{" "}
                </span>
                {m.wires[k].cross}
              </p>
              <p class="smap__how">{m.wires[k].how}</p>
            </li>
          )}
        </>
      ))
    }
    <li class="smap__never">
      <span class="sr-only">Between your mail provider and Moduo, London: </span>
      <span class="smap__never-l">{m.never.label}</span>
      <span class="sr-only">. {m.never.text}</span>
    </li>
  </ol>
</div>

<style>
  .smap-wrap {
    row-gap: calc(var(--u) * 5);
    align-items: start;
  }

  /* ── The map ─────────────────────────────────────────────────────────── */
  .smap {
    --ns: clamp(1.5rem, 1.05rem + 1.4vw, 2.5rem); /* a place's name */
    --nc: calc(var(--ns) * 0.575); /* the node's centre, from the top of its place: the name's middle */
    --nw: calc(var(--ns) * 1.75); /* the node column; the line runs down its middle */
    --lit: var(--c-fg);
    --off: var(--c-line-strong);
    grid-column: 1 / span 7;
    grid-row: 1;
    display: grid;
    grid-template-columns: [by] 2.75rem [node] var(--nw) [info] minmax(0, 1fr);
    position: relative;
  }
  .smap__place,
  .smap__wire {
    grid-column: node / -1;
    display: grid;
    grid-template-columns: subgrid;
    position: relative;
    z-index: 1;
  }
  .smap__place {
    padding-bottom: 0.25rem;
  }
  /* The line carries on under a place's node, to the wire below it. */
  .smap__place[data-down]::after {
    content: "";
    position: absolute;
    left: calc(var(--nw) / 2);
    top: calc(var(--nc) * 2 + 0.375rem);
    bottom: 0;
    width: 1px;
    background: var(--c-dim);
    transition: background-color var(--d-hover) var(--ease);
  }
  .smap__node {
    grid-column: 1;
    display: flex;
    justify-content: center;
    height: calc(var(--nc) * 2);
  }
  .smap__stroke {
    height: 100%;
    width: auto;
    fill: var(--c-dim);
    transition: fill var(--d-hover) var(--ease);
  }
  /* The mark is the mark: always Paper, never dimmed (brand 25). */
  .smap__mark {
    height: 100%;
    width: auto;
    fill: var(--c-fg);
  }
  .smap__info {
    grid-column: 2;
    display: grid;
    gap: 0.375rem;
    padding-left: 1rem;
  }
  .smap__name {
    font-size: var(--ns);
    line-height: 1.15;
    letter-spacing: var(--tr-l);
    font-weight: var(--w-text);
    transition: color var(--d-hover) var(--ease);
  }
  .smap__sub {
    font-size: var(--t-s);
    font-weight: var(--w-small);
    color: var(--c-quiet);
  }
  .smap__holds {
    display: grid;
    gap: 0.125rem;
    margin-top: 0.75rem;
    font-size: var(--t-body);
    line-height: 1.5;
    color: var(--c-muted);
    transition: color var(--d-hover) var(--ease);
  }
  .smap__holds li {
    position: relative;
    padding-left: 1rem;
  }
  /* The site's list dot (Plans): a short rule here read as a dash before every line. */
  .smap__holds li::before {
    content: "";
    position: absolute;
    left: 0;
    top: calc(0.75em - 0.1875rem);
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 50%;
    background: var(--c-quiet);
  }

  /* A wire: the line down the node column, a small dot at each end, the words beside it. */
  .smap__wire {
    align-content: center;
    min-height: 9.5rem;
    padding-block: 1.25rem;
  }
  .smap__line {
    position: absolute;
    left: calc(var(--nw) / 2);
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--c-dim);
    transition: background-color var(--d-hover) var(--ease);
  }
  .smap__line::before,
  .smap__line::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: inherit;
    translate: -50% 0;
  }
  .smap__line::before {
    top: 0;
  }
  .smap__line::after {
    bottom: 0.375rem;
  }
  /* The one thing you follow, running the line once. */
  .smap__dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 9px;
    height: 9px;
    margin-left: -4.5px;
    border-radius: 50%;
    background: var(--c-fg);
    box-shadow: 0 0 0 4px var(--c-bg);
    opacity: 0;
    pointer-events: none;
  }
  .smap__cross,
  .smap__how {
    grid-column: 2;
    padding-left: 1rem;
    transition: color var(--d-hover) var(--ease);
  }
  .smap__cross {
    font-size: var(--t-body);
    font-weight: var(--w-ui);
  }
  .smap__how {
    margin-top: 0.125rem;
  }
  .smap__how {
    font-size: var(--t-s);
    font-weight: var(--w-small);
    color: var(--c-muted);
    max-width: 30rem;
  }

  /* Never connected: a dashed bracket from the mail provider's node to Moduo's, cut by its label. */
  .smap__never {
    grid-column: by;
    grid-row: 1 / 5;
    position: relative;
    margin: var(--nc) calc(var(--nw) / -2) calc(-1 * var(--nc)) 1rem;
    border: 1px dashed var(--c-line-strong);
    border-right: 0;
    border-radius: var(--r-md) 0 0 var(--r-md);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
  }
  .smap__never-l {
    position: absolute;
    left: 0;
    top: 50%;
    translate: -50% -50%;
    padding: 0.75rem 0;
    background: var(--c-bg);
    writing-mode: vertical-rl;
    rotate: 180deg;
    font-size: var(--t-xs);
    font-weight: var(--w-ui);
    letter-spacing: var(--tr-xs);
    color: var(--c-quiet);
    white-space: nowrap;
  }

  /* Following one thing: its places and wires light, the rest step back. */
  .smap[data-follow] :is(.smap__line, .smap__place[data-down]::after) {
    background: var(--off);
  }
  .smap[data-follow] .smap__name {
    color: var(--c-quiet);
  }
  .smap[data-follow] .smap__holds,
  .smap[data-follow] .smap__how {
    color: var(--c-quiet);
  }
  .smap[data-follow] .smap__cross {
    color: var(--c-quiet);
  }
  .smap[data-follow="email"] [data-on~="email"] :is(.smap__name, .smap__cross),
  .smap[data-follow="task"] [data-on~="task"] :is(.smap__name, .smap__cross),
  .smap[data-follow="key"] [data-on~="key"] :is(.smap__name, .smap__cross) {
    color: var(--c-fg);
  }
  .smap[data-follow="email"] [data-on~="email"] :is(.smap__holds, .smap__how),
  .smap[data-follow="task"] [data-on~="task"] :is(.smap__holds, .smap__how),
  .smap[data-follow="key"] [data-on~="key"] :is(.smap__holds, .smap__how) {
    color: var(--c-muted);
  }
  .smap[data-follow="email"] [data-on~="email"] .smap__line,
  .smap[data-follow="task"] [data-on~="task"] .smap__line,
  .smap[data-follow="key"] [data-on~="key"] .smap__line,
  .smap[data-follow="email"] [data-down~="email"]::after,
  .smap[data-follow="task"] [data-down~="task"]::after,
  .smap[data-follow="key"] [data-down~="key"]::after {
    background: var(--lit);
  }
  .smap[data-follow="email"] [data-on~="email"] .smap__stroke,
  .smap[data-follow="task"] [data-on~="task"] .smap__stroke,
  .smap[data-follow="key"] [data-on~="key"] .smap__stroke {
    fill: var(--c-fg);
  }
  /* Following the email, the bracket says its piece: the mailbox and Moduo never meet. */
  .smap[data-follow="email"] .smap__never {
    border-color: var(--c-muted);
  }
  .smap[data-follow="email"] .smap__never-l {
    color: var(--c-fg);
  }

  /* ── Follow ──────────────────────────────────────────────────────────── */
  .sfol {
    grid-column: 9 / span 4;
    grid-row: 1;
    position: sticky;
    top: calc(var(--nav-h) + 2rem);
  }
  .sfol__k {
    margin-bottom: 0.75rem;
    font-weight: var(--w-ui);
    color: var(--c-quiet);
  }
  .sfol__item {
    border-top: 1px solid var(--c-line-strong);
    padding-bottom: 1.25rem;
  }
  .sfol__b {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
    min-height: 3.25rem;
    text-align: left;
    font-size: var(--t-m);
    letter-spacing: var(--tr-m);
    font-weight: var(--w-ui);
    color: var(--c-muted);
    transition: color var(--d-hover) var(--ease);
  }
  .sfol__n {
    display: inline-block;
    transition: translate 0.5s var(--ease);
  }
  .sfol__t {
    max-width: 30rem;
    font-size: var(--t-s);
    font-weight: var(--w-small);
    line-height: 1.55;
    color: var(--c-quiet);
    transition: color var(--d-hover) var(--ease);
  }
  .sfol__b[aria-pressed="true"] {
    color: var(--c-fg);
  }
  .sfol__item:has(.sfol__b[aria-pressed="true"]) .sfol__t {
    color: var(--c-muted);
  }
  .sfol__b[aria-pressed="true"] :global(.sp),
  :global(html:not(.js)) .sfol__b :global(.sp) {
    --g: 1;
  }
  @media (hover: hover) {
    .sfol__b:hover {
      color: var(--c-fg);
    }
    .sfol__b:hover .sfol__n {
      translate: 0.4em 0;
    }
    .sfol__b:hover :global(.sp) {
      --g: 1;
    }
  }
  .sfol__b:focus-visible .sfol__n {
    translate: 0.4em 0;
  }
  /* Without JS there is nothing to switch: the three read as a list, all in full. */
  :global(html:not(.js)) .sfol__b {
    pointer-events: none;
    color: var(--c-fg);
  }
  :global(html:not(.js)) .sfol__t {
    color: var(--c-muted);
  }

  @media (max-width: 999px) {
    .sfol {
      grid-column: 1 / -1;
      position: static;
    }
    .smap {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
  @media (max-width: 560px) {
    .smap {
      grid-template-columns: [by] 1.75rem [node] var(--nw) [info] minmax(0, 1fr);
    }
    .smap__never {
      margin-left: 0.5rem;
    }
    .smap__info,
    .smap__cross,
    .smap__how {
      padding-left: 0.625rem;
    }
    .smap__holds {
      font-size: var(--t-s);
    }
    .smap__wire {
      min-height: 7rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .smap__dot {
      display: none;
    }
  }
</style>
