  /* The poster's frame: hairlines, the metric lines' names, its head of facts. */
  .tf__lockup {
    fill: var(--c-fg);
  }
  .tf__pread {
    font-variant-numeric: tabular-nums;
    white-space: pre;
  }
  .tf__wt {
    fill: var(--c-quiet);
    font-size: 52px;
    font-weight: var(--w-text);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
