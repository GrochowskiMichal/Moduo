    font-weight: var(--w-text);
    font-variant-numeric: tabular-nums;
    white-space: pre;
  }
  .tf__fill {
    fill: var(--c-fg);
  }
  /* Every outline over the strokes, in the ground: where one stroke lies on another, it shows. */
  .tf__seam {
    fill: none;
    stroke: var(--c-bg);
    stroke-width: 1.25px;
    vector-effect: non-scaling-stroke;
  }
  /* The outline as it's drawn in, before the strokes fill. */
  .tf__wire {
    fill: none;
    stroke: var(--c-muted);
