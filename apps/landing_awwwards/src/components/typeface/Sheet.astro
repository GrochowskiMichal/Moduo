  .tf__small {
    fill: var(--c-muted);
    font-weight: var(--w-text);
  }
  .tf__imprint {
    fill: var(--c-muted);
  }
  .tf__wall {
    fill: var(--c-fg);
    font-weight: var(--w-text);
  }
  /* The cell being drawn on the plate: Paper, its character in the ground. */
  .tf__lit {
    fill: var(--c-fg);
  }
  .tf__litch {
    fill: var(--c-bg);
  }
  .tf__lit,
  .tf__litch {
    display: none;
