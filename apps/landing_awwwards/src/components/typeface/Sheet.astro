  :global(html.motion) .tf__live,
  :global(html.motion) .tf__poster {
    display: block;
  }
  /* With motion the imprint stands at the poster's foot instead. */
  :global(html.motion) [data-tf-row="imprint"] {
    display: none;
  }
  /* Without motion the h1 is the head, and the band shows nothing. */
  .tf__head {
    display: none;
  }

  /* ── With motion: one held stage, one camera, the whole sheet. The h1 stays the name (for
     readers and the first paint); the drawing lies exactly over it and takes over as the scroll
     starts. ── */
  :global(html.motion) .tf {
    height: 1700svh;
    padding: 0;
  }
  :global(html.motion) .tf__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    overflow: hidden;
  }
  :global(html.motion) .tf__sheet {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    pointer-events: none;
    opacity: 0;
  }
  :global(html.motion) .tf__head,
  :global(html.motion) .tf__halves,
  :global(html.motion) .tf__lit,
  :global(html.motion) .tf__litch {
    display: block;
  }
  :global(html.motion) .tf__halves {
    opacity: 0;
  }
  /* One endless scene: the footer steps out of the flow (styles/base.css). */
  :global(html.motion) .tf__beats {
    display: grid;
    grid-template-columns: 1fr;
    position: absolute;
    left: calc(var(--margin) - 1rem);
    bottom: calc(var(--u) * 6);
    width: min(28rem, calc(100% - 2 * var(--margin) + 2rem));
    max-width: none;
    margin: 0;
    padding: 0;
    z-index: 1;
  }
  /* The words sit in a band at the stage's foot that the drawing fades under. On a wide screen
     the band is only as wide as the words, so the sheet beside them shows whole. */
  :global(html.motion) .tf__stage::after {
    content: "";
