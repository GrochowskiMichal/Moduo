---
// One widget of the home board (components/home/DuskWindow.astro): a panel with the board's
// padding, a header row (an icon box, the title, and whatever the widget puts at the right)
// and the widget's own content. Every widget on the board is one of these, so the padding, the
// header and the radius are the same everywhere; what a widget shows is its own file.
import Icon from "../../frames/Icon.astro";
import type { IconName } from "../../../lib/app-icons";

interface Props {
  /** The driver's name for the widget (data-w) and its class suffix (dk-<slug>). */
  slug: "mail" | "note" | "tasks" | "chat" | "cal";
  icon: IconName;
  title: string;
  class?: string;
}
const { slug, icon, title, class: className } = Astro.props;
---

<section class:list={["dk-w", `dk-${slug}`, className]} data-w={slug}>
  <p class="dk-wh">
    <span class="dk-ic"><Icon name={icon} /></span>
    <span class="dk-wt ap-ell">{title}</span>
    <slot name="right" />
  </p>
  <slot />
</section>

<style is:global>
  .dk-w {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    padding: var(--pad);
    border-radius: var(--r);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.05), rgb(255 255 255 / 0.018));
    box-shadow:
      inset 0 0 0 1px var(--ap-hairline),
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 0.6em 1.4em -0.8em rgb(0 0 0 / 0.6);
    overflow: hidden;
    isolation: isolate;
    transition: opacity 1.2s var(--ease);
  }
  /* Depth of field by light alone: what the chapter is not about steps back, and the widget it
     is about takes a brighter edge. Opacities only, the edge on a layer of its own: a shadow or
     a scale changing under the camera re-rastered the whole window on every frame of the move
     (and a scale shimmered its text). */
  .dk-w::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.22),
      inset 0 1px 0 rgb(255 255 255 / 0.12);
    opacity: 0;
    transition: opacity 1.2s var(--ease);
    pointer-events: none;
  }
  .dk-w.is-dim {
    opacity: 0.32;
  }
  .dk-w.is-focus::after {
    opacity: 1;
  }
  /* The header: the icon box, the title, the right slot (a count, a ring, arrows). */
  .dk-wh {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.65em;
    height: var(--head);
    margin: 0 0 var(--head-gap);
    font-size: 0.95em;
    font-weight: 500;
    line-height: 1;
  }
  .dk-ic {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: var(--head);
    height: var(--head);
    border-radius: 0.55em;
    background: rgb(255 255 255 / 0.06);
    color: var(--ap-muted);
  }
  .dk-ic .ap-i {
    width: 1em;
    height: 1em;
  }
  .dk-wt {
    min-width: 0;
  }
  .dk-wh .ap-meta,
  .dk-wh .dk-right {
    margin-left: auto;
  }
  .dk-right {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    color: var(--ap-muted);
  }
</style>
