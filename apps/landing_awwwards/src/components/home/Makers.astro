---
// Made by a duo: the founders, real photos with consent (brand decision 68), their own words.
import { Image } from "astro:assets";

import StrokePair from "../StrokePair.astro";
import maciej from "../../assets/makers/maciej.jpg";
import mike from "../../assets/makers/mike.jpg";
import { makers } from "../../data/site";

const photos = { maciej, mike } as const;
---

<section class="makers" id="makers" aria-labelledby="makers-title">
  <div class="wrap grid">
    <div class="makers__head">
      <StrokePair class="makers__glyph" size="clamp(2rem, 3.4vw, 3.25rem)" data-join />
      <h2 class="makers__title t-xl" id="makers-title" data-split>{makers.title}</h2>
      <p class="makers__text t-m muted" data-reveal>{makers.text}</p>
      <p class="makers__name t-s" data-reveal>{makers.name}</p>
      <p class="makers__links" data-reveal>
        <a class="makers__more link t-s" href="/about">{makers.more}</a>
        <a class="makers__more link t-s" href="/typeface">{makers.type}</a>
      </p>
    </div>
    {
      makers.people.map((p, i) => (
        <figure class:list={["maker", `maker--${i}`]} data-reveal="frame">
          <Image
            class="maker__photo"
            src={photos[p.photo as keyof typeof photos]}
            alt={`${p.name}, ${p.role.toLowerCase()} at Moduo`}
            widths={[320, 480, 720]}
            sizes="(max-width: 900px) 90vw, 30vw"
            loading="lazy"
            decoding="async"
          />
          <figcaption>
            <p class="maker__name">{p.name}</p>
            <p class="maker__role t-s quiet">{p.does}</p>
            <blockquote class="maker__quote">
              <p>“{p.quote}”</p>
            </blockquote>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>

<style>
  .makers {
    padding: calc(var(--u) * 8) 0 calc(var(--u) * 6);
  }
  .makers__head {
    grid-column: 1 / span 4;
    display: grid;
    align-content: start;
    gap: 1.5rem;
  }
  .makers__title {
    margin-left: -0.04em;
  }
  .makers__name {
    font-weight: var(--w-ui);
  }
  .makers__links {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
  }
  /* A 24 px tap target at least, without moving the line. */
  .makers__more {
    padding-block: 0.375rem;
    margin-block: -0.375rem;
  }
  /* Two strokes, two of us: apart until the section arrives, then one shared window. */
  .makers__head :global(.makers__glyph) {
    margin-bottom: 0.5rem;
  }
  .maker {
    grid-row: 1;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .maker--0 {
    grid-column: 5 / span 4;
  }
  .maker--1 {
    grid-column: 9 / span 4;
    margin-top: calc(var(--u) * 12);
  }
  .maker__photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-lg);
    filter: grayscale(1) contrast(1.05);
  }
  .maker__name {
    font-size: var(--t-m);
    font-weight: var(--w-display);
    letter-spacing: var(--tr-m);
  }
  .maker__quote {
    margin-top: 1rem;
    color: var(--c-muted);
    hanging-punctuation: first;
  }
  .maker__quote p {
    text-indent: -0.42em;
  }
  @media (max-width: 900px) {
    .makers__head,
    .maker--0,
    .maker--1 {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .maker--0 {
      margin-top: calc(var(--u) * 6);
    }
    .maker--1 {
      margin-top: calc(var(--u) * 6);
    }
    .maker__photo {
      max-width: 22rem;
    }
  }
</style>
