---
// /security: where your work lives, what keeps it there, what isn't built yet, who else handles
// it, and how you take it back. The signature is the map (components/security/Map.astro): follow
// one thing and its path lights. Facts: src/data/pages/security.ts.
import Btn from "../components/Btn.astro";
import Faq from "../components/Faq.astro";
import Controls from "../components/security/Controls.astro";
import Map from "../components/security/Map.astro";
import Head from "../components/page/Head.astro";
import PageHero from "../components/page/PageHero.astro";
import Related from "../components/page/Related.astro";
import { security as s } from "../data/pages/security";
import { waitlist } from "../data/site";
import Base from "../layouts/Base.astro";
import { STROKE, STROKE_PATH } from "../lib/stroke";
import { crumbs, faq } from "../lib/seo";

const strokeVb = `0 ${STROKE.top} ${STROKE.w} ${STROKE.bottom - STROKE.top}`;
const [before, after] = s.report.text.split(s.report.email);
---

<Base title={s.title} description={s.description} image="/og/security.png" jsonLd={[crumbs(["Security", "/security"]), faq(s.faq.items)]}>
  <div data-pg="security">
    <PageHero name={s.name} line={s.line} lead={s.lead} family="product" current="security">
      <Fragment slot="cta">
        <Btn data-wl-open="nav">{waitlist.button}</Btn>
        <Btn variant="ghost" href="/privacy">{s.cta.policy}</Btn>
      </Fragment>
    </PageHero>

    <section class="pg" id="map" aria-labelledby="map-title">
      <div class="wrap">
        <Head id="map-title" title={s.map.title} text={s.map.text} />
        <Map />
      </div>
    </section>

    <section class="pg pg--chapter" aria-labelledby="ctl-title">
      <div class="wrap">
        <Head id="ctl-title" title={s.controls.title} text={s.controls.text} />
        <div data-reveal="frame">
          <Controls />
        </div>
      </div>
    </section>

    <section class="pg pg--chapter" aria-labelledby="yet-title">
      <div class="wrap grid pg-side">
        <div class="pg-side__head yet__head">
          <h2 class="t-xl yet__title" id="yet-title" data-split>{s.notYet.title}</h2>
          <p class="muted" data-reveal>{s.notYet.text}</p>
        </div>
        <ul class="pg-side__body yet">
          {
            s.notYet.items.map((item) => (
              <li class="yet__item" data-reveal>
                <svg class="yet__glyph" viewBox={strokeVb} aria-hidden="true">
                  <path d={STROKE_PATH} />
                </svg>
                <h3 class="yet__t t-m">{item.title}</h3>
                <p class="yet__d muted">{item.text}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="pg pg--chapter" aria-labelledby="who-title">
      <div class="wrap">
        <Head id="who-title" title={s.vendors.title} text={s.vendors.text} size="l" />
        <div class="who__scroll" tabindex="0" role="region" aria-label="The companies that run parts of Moduo" data-reveal>
          <table class="who">
            <thead>
              <tr>{s.vendors.head.map((h) => <th scope="col">{h}</th>)}</tr>
            </thead>
            <tbody>
              {
                s.vendors.rows.map(([name, does, where]) => (
                  <tr>
                    <th scope="row">{name}</th>
                    <td>{does}</td>
                    <td>{where}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <div class="who__foot" data-reveal>
          <p class="t-s muted">{s.vendors.note}</p>
          <p class="who__links t-s">
            <a class="link" href="/privacy">{s.vendors.privacy}</a>
            <a class="link" href="/dpa">{s.vendors.dpa}</a>
          </p>
        </div>
      </div>
    </section>

    <section class="pg pg--chapter" aria-labelledby="out-title">
      <div class="wrap">
        <Head id="out-title" title={s.rights.title} text={s.rights.text} />
        <dl class="out">
          {
            s.rights.items.map((r) => (
              <div class="out__col" data-reveal>
                <dt class="out__k">
                  <span class="out__fig">{r.figure}</span>
                  <span class="out__name">{r.k}</span>
                </dt>
                <dd class="out__d muted">{r.text}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="pg pg--chapter rep" aria-labelledby="rep-title">
      <div class="wrap grid">
        <h2 class="rep__title t-xl" id="rep-title" data-split>{s.report.title}</h2>
        <div class="rep__body" data-reveal>
          <p class="t-m muted">
            {before}<a class="link rep__mail" href={`mailto:${s.report.email}?subject=Security`}>{s.report.email}</a>{after}
          </p>
          <Btn href={`mailto:${s.report.email}?subject=Security`} arrow>{s.report.button}</Btn>
        </div>
      </div>
    </section>

    <Faq id="sec-faq" title={s.faq.title} items={s.faq.items} />

    <Related title={s.related} slugs={["ai", "download", "help"]} />
  </div>
</Base>

<style>
  /* Not yet: each one an outlined stroke, the plans' grammar for "not filled in". */
  .yet__title {
    max-width: 10ch;
  }
  @media (max-width: 900px) {
    .yet__title {
      max-width: none;
    }
  }
  .yet {
    display: grid;
  }
  .yet__item {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr);
    column-gap: 1.25rem;
    row-gap: 0.375rem;
    padding: 1.5rem 0 1.75rem;
    border-top: 1px solid var(--c-line-strong);
  }
  .yet__item:last-child {
    border-bottom: 1px solid var(--c-line-strong);
  }
  .yet__glyph {
    grid-row: 1 / span 2;
    width: 1.25rem;
    height: auto;
    margin-top: 0.2rem;
    fill: none;
    stroke: var(--c-muted);
    stroke-width: 14;
    overflow: visible;
  }
  .yet__t {
    font-weight: var(--w-ui);
  }
  .yet__d {
    max-width: 36rem;
  }

  /* Who else handles it: the pricing page's table grammar. */
  .who__scroll {
    overflow-x: auto;
    border-radius: var(--r-sm);
  }
  .who {
    width: 100%;
    min-width: 40rem;
    border-collapse: collapse;
    font-size: var(--t-s);
  }
  .who th,
  .who td {
    text-align: left;
    vertical-align: top;
    padding: 1rem 1.5rem 1rem 0;
    border-bottom: 1px solid var(--c-line);
    font-weight: var(--w-small);
  }
  .who thead th {
    padding-top: 0;
    font-size: var(--t-xs);
    font-weight: var(--w-ui);
    letter-spacing: var(--tr-xs);
    color: var(--c-quiet);
    border-bottom-color: var(--c-line-strong);
  }
  /* The vendor's name, what it does, where: the columns start on lines 5 and 9. */
  .who tbody th {
    width: 34%;
    font-size: var(--t-body);
    font-weight: var(--w-ui);
    color: var(--c-fg);
  }
  .who tbody td {
    color: var(--c-muted);
  }
  .who tbody td:last-child {
    width: 32%;
    color: var(--c-fg);
  }
  .who__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem 2rem;
    margin-top: 1.5rem;
  }
  .who__links {
    display: flex;
    gap: 1.5rem;
  }
  /* A phone reads each company as a block: the name and where on one line, what it does under. */
  @media (max-width: 720px) {
    .who {
      min-width: 0;
    }
    .who thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
    .who tbody tr {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 1rem;
      row-gap: 0.25rem;
      padding: 1rem 0;
      border-bottom: 1px solid var(--c-line);
    }
    .who tbody :is(th, td) {
      padding: 0;
      border: 0;
      width: auto;
    }
    .who tbody td:last-child {
      grid-column: 2;
      grid-row: 1;
      align-self: center;
      width: auto;
      text-align: right;
    }
    .who tbody td:nth-child(2) {
      grid-column: 1 / -1;
    }
  }

  /* Yours to take: four columns, each a figure, the right's name, and how. */
  .out {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .out__col {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-line-strong);
  }
  .out__k {
    display: grid;
    gap: 0.5rem;
  }
  .out__fig {
    font-size: var(--t-l);
    line-height: var(--lh-l);
    letter-spacing: var(--tr-l);
    font-weight: var(--w-light);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .out__name {
    font-size: var(--t-s);
    font-weight: var(--w-ui);
    color: var(--c-fg);
  }
  .out__d {
    margin: 0;
    font-size: var(--t-s);
    font-weight: var(--w-small);
    line-height: 1.55;
  }

  /* Found a problem: the page's last word before the questions. */
  .rep__title {
    grid-column: 1 / span 6;
    margin-left: -0.04em;
  }
  .rep__body {
    grid-column: 9 / span 4;
    align-self: end;
    display: grid;
    justify-items: start;
    gap: 1.5rem;
  }
  .rep__mail {
    color: var(--c-fg);
  }

  @media (max-width: 900px) {
    .rep__title,
    .rep__body {
      grid-column: 1 / -1;
    }
    .rep__body {
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 1099px) {
    .out {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .out {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
