---
// /press: the press kit (brand brief §13, decision 66). The logo measured on a plate, the files,
// how not to use it, the lines we use (copy buttons, motion/copy.ts), the name said aloud, the
// facts, the founders and an address. Copy: src/data/pages/press.ts.
import { Image } from "astro:assets";

import Btn from "../components/Btn.astro";
import Head from "../components/page/Head.astro";
import PageHero from "../components/page/PageHero.astro";
import Related from "../components/page/Related.astro";
import Files from "../components/press/Files.astro";
import Misuse from "../components/press/Misuse.astro";
import Plate from "../components/press/Plate.astro";
import maciej from "../assets/makers/maciej.jpg";
import mike from "../assets/makers/mike.jpg";
import { press as p } from "../data/pages/press";
import { makers } from "../data/site";
import Base from "../layouts/Base.astro";
import { crumbs } from "../lib/seo";

const photos = { maciej, mike } as const;
const does = Object.fromEntries(makers.people.map((m) => [m.photo, m.does]));
const mail = `mailto:${p.contact.email}?subject=Press`;
---

<Base title={p.title} description={p.description} image="/og/press.png" jsonLd={[crumbs(["Press kit", "/press"])]}>
  <div data-pg="press">
    <PageHero name={p.name} line={p.line} lead={p.lead} family="company" current="press">
      <Fragment slot="cta">
        <Btn href={p.kit.href} download>{p.cta.kit}</Btn>
        <Btn variant="ghost" href={mail}>{p.cta.email}</Btn>
      </Fragment>
    </PageHero>

    <section class="pg" id="logo" aria-labelledby="plate-title">
      <div class="wrap">
        <Head id="plate-title" title={p.plate.title} text={p.plate.text} />
        <div data-reveal="frame">
          <Plate />
        </div>
      </div>
    </section>

    <section class="pg pg--chapter" id="files" aria-labelledby="files-title">
      <div class="wrap">
        <Head id="files-title" title={p.files.title} text={p.files.text} />
        <div data-reveal="frame">
          <Files />
        </div>
      </div>
    </section>

    <section class="pg" aria-labelledby="mis-title">
      <div class="wrap">
        <Head id="mis-title" title={p.misuse.title} text={p.misuse.text} size="l" />
        <div data-reveal>
          <Misuse />
        </div>
      </div>
    </section>

    <section class="pg pg--chapter" id="lines" aria-labelledby="lines-title">
      <div class="wrap">
        <Head id="lines-title" title={p.lines.title} text={p.lines.text} />
        <ul class="lines">
          {
            p.lines.items.map((l) => (
              <li class:list={["lines__item", `is-${l.id}`]} data-copy-scope data-reveal>
                <div class="lines__bar">
                  <p class="lines__label">{l.label}</p>
                  <button class="lines__copy" type="button" data-copy>
                    <span data-copy-label>{p.lines.copy}</span>
                    <span class="sr-only" aria-live="polite" data-copy-status />
                  </button>
                </div>
                <p class="lines__text" data-copy-source>
                  {l.text}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="pg pg--chapter say" aria-labelledby="say-title">
      <div class="wrap grid say__in">
        <h2 class="say__title t-s" id="say-title">{p.say.title}</h2>
        <p class="say__word" data-reveal>
          {
            p.say.syllables.map((syl, i) => (
              <>
                {i > 0 && (
                  <span class="say__dot" aria-hidden="true">
                    ·
                  </span>
                )}
                <span class:list={["say__syl", i === 1 && "is-stress"]}>{syl}</span>
              </>
            ))
          }
        </p>
        <p class="say__text t-m muted" data-reveal>{p.say.text}</p>
        <div class="say__kana" data-reveal>
          <p class="say__kana-w" lang="ja">{p.say.kana}</p>
          <p class="t-s quiet">{p.say.kanaText}</p>
        </div>
        <p class="say__write t-s muted" data-reveal>{p.say.write}</p>
      </div>
    </section>

    <section class="pg pg--chapter" aria-labelledby="facts-title">
      <div class="wrap">
        <Head id="facts-title" title={p.facts.title} size="l" />
        <dl class="facts" data-reveal>
          {
            p.facts.rows.map((r) => (
              <div class="facts__cell">
                <dt class="facts__k">{r.k}</dt>
                <dd class="facts__v">
                  {"href" in r && r.href ? (
                    <a class="link" href={r.href} rel="me">
                      {r.v}
                    </a>
                  ) : (
                    r.v
                  )}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="pg pg--chapter" aria-labelledby="duo-title">
      <div class="wrap">
        <Head id="duo-title" title={p.founders.title} size="l" />
        <ul class="duo">
          {
            p.founders.people.map((f) => (
              <li class="duo__p" data-reveal>
                <Image
                  class="duo__photo"
                  src={photos[f.photo]}
                  alt={`${f.name}, ${f.role.toLowerCase()} of Moduo`}
                  widths={[320, 560, 800]}
                  sizes="(max-width: 720px) 100vw, 30vw"
                  loading="lazy"
                />
                <div class="duo__text">
                  <h3 class="duo__name t-m">{f.name}</h3>
                  <p class="duo__role t-s">{f.role}</p>
                  <p class="duo__does t-s muted">{does[f.photo]}</p>
                  <a class="link duo__dl t-s" href={`/press/${f.file}`} download>
                    {p.founders.download} <span class="quiet">{p.founders.meta}</span>
                  </a>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="pg pg--chapter hi" aria-labelledby="hi-title">
      <div class="wrap grid">
        <h2 class="hi__title t-xl" id="hi-title" data-split>{p.contact.title}</h2>
        <div class="hi__body" data-reveal>
          <a class="hi__mail t-l" href={mail}>
            <span class="hi__mail-t">{p.contact.email}</span>
            <svg class="hi__arrow" width="28" height="28" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M2 7h9.5M7.5 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.2" />
            </svg>
          </a>
          <p class="t-m muted">{p.contact.text}</p>
        </div>
      </div>
    </section>

    <Related title={p.related} slugs={["about", "colophon", "typeface"]} />
  </div>
</Base>

<style>
  /* The lines: the paragraph large on the left, the short lines stacked beside it. */
  .lines {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: repeat(3, auto);
    gap: var(--gutter);
  }
  .lines__item {
    grid-column: 8 / -1;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1.25rem 1.5rem 1.5rem;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-lg);
    background: var(--c-card);
  }
  .lines__item.is-paragraph {
    grid-column: 1 / span 7;
    grid-row: 1 / span 3;
  }
  .lines__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 2rem;
  }
  .lines__label {
    font-size: var(--t-xs);
    font-weight: var(--w-ui);
    letter-spacing: var(--tr-xs);
    color: var(--c-quiet);
  }
  .lines__copy {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    margin-right: -0.5rem;
    padding: 0 0.75rem;
    border-radius: var(--r-md);
    font-size: var(--t-xs);
    font-weight: var(--w-ui);
    color: var(--c-muted);
    transition:
      background-color var(--d-hover) var(--ease),
      color var(--d-hover) var(--ease);
  }
  @media (hover: hover) {
    .lines__copy:hover {
      background: var(--c-hover);
      color: var(--c-fg);
    }
  }
  .lines__copy:global(.is-copied) {
    color: var(--c-fg);
  }
  :global(html:not(.js)) .lines__copy {
    display: none;
  }
  .lines__text {
    font-size: var(--t-m);
    line-height: var(--lh-m);
    letter-spacing: var(--tr-m);
  }
  .is-paragraph .lines__text {
    font-size: var(--t-l);
    line-height: 1.22;
    letter-spacing: var(--tr-l);
    font-weight: var(--w-light);
    max-width: 30ch;
  }

  /* Say it: the name as three syllables at display size, the stress lit. */
  .say__in {
    row-gap: 1.25rem;
  }
  .say__title {
    grid-column: 1 / -1;
    font-weight: var(--w-ui);
    color: var(--c-quiet);
  }
  .say__word {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0 0.18em;
    margin-left: -0.05em;
    font-size: clamp(3.5rem, 1rem + 11vw, 12.5rem);
    line-height: 0.95;
    letter-spacing: var(--tr-mega);
    font-weight: var(--w-display);
  }
  .say__syl {
    color: var(--c-quiet);
  }
  .say__syl.is-stress {
    color: var(--c-fg);
  }
  .say__dot {
    color: var(--c-line-strong);
  }
  .say__text {
    grid-column: 1 / span 5;
    grid-row: 3;
    max-width: 30rem;
    margin-top: 1.5rem;
  }
  .say__kana {
    grid-column: 9 / span 4;
    grid-row: 3 / span 2;
    display: grid;
    gap: 0.75rem;
    align-content: start;
    margin-top: 1.5rem;
  }
  .say__kana-w {
    font-size: var(--t-l);
    line-height: 1;
    font-weight: var(--w-text);
  }
  .say__write {
    grid-column: 1 / span 5;
    grid-row: 4;
    max-width: 30rem;
  }

  /* The facts: a spec sheet, hairline cells like the footer's. */
  .facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .facts__cell {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: 1.25rem 1.5rem 1.5rem;
    background: var(--c-bg);
  }
  .facts__k {
    font-size: var(--t-xs);
    font-weight: var(--w-ui);
    letter-spacing: var(--tr-xs);
    color: var(--c-quiet);
  }
  .facts__v {
    margin: 0;
    font-size: var(--t-body);
    line-height: 1.45;
  }

  /* The founders: photo, name, role, what each does, the photo to download. */
  .duo {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
  }
  .duo__p {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1fr);
    gap: clamp(1rem, 2vw, 1.75rem);
    align-items: end;
  }
  .duo__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--r-lg);
    /* Held as a raised square while the photo loads, never a hole. */
    background: var(--c-raised);
  }
  .duo__text {
    display: grid;
    gap: 0.375rem;
    justify-items: start;
  }
  .duo__name {
    font-weight: var(--w-ui);
  }
  .duo__role {
    color: var(--c-fg);
  }
  .duo__does {
    max-width: 22rem;
  }
  .duo__dl {
    margin-top: 0.75rem;
  }

  /* Writing about Moduo: the address, large, is the link. */
  .hi__title {
    grid-column: 1 / span 6;
    margin-left: -0.04em;
  }
  .hi__body {
    grid-column: 9 / span 4;
    align-self: end;
    display: grid;
    gap: 1rem;
  }
  .hi__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    justify-self: start;
    font-weight: var(--w-text);
  }
  .hi__mail-t {
    padding-bottom: 0.08em;
    background: linear-gradient(var(--c-fg), var(--c-fg)) 0 100% / 0% 1px no-repeat,
      linear-gradient(var(--c-quiet), var(--c-quiet)) 0 100% / 100% 1px no-repeat;
    transition: background-size var(--d-hover) var(--ease);
  }
  .hi__arrow {
    transition: translate var(--d-hover) var(--ease);
  }
  @media (hover: hover) {
    .hi__mail:hover .hi__mail-t {
      background-size:
        100% 1px,
        100% 1px;
    }
    .hi__mail:hover .hi__arrow {
      translate: 0.25em 0;
    }
  }
  .hi__mail:focus-visible .hi__mail-t {
    background-size:
      100% 1px,
      100% 1px;
  }

  @media (max-width: 999px) {
    .lines__item,
    .lines__item.is-paragraph {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .duo {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 2.5rem;
    }
  }
  @media (max-width: 900px) {
    .say__text,
    .say__kana,
    .say__write,
    .hi__title,
    .hi__body {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    .hi__body {
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 560px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .duo__p {
      grid-template-columns: minmax(0, 1fr);
    }
    .duo__photo {
      max-width: 18rem;
    }
    .hi__mail {
      font-size: clamp(1.5rem, 7.4vw, 2rem);
    }
    .say__word {
      font-size: 13vw;
    }
  }
</style>
