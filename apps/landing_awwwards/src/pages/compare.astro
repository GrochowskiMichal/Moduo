---
// Moduo next to the apps it replaces: one client's morning kept in a stack and in Moduo (the
// signature, components/compare/WhereThingsLive.astro), then app by app, the bill, and the
// questions people ask before they switch.
import Btn from "../components/Btn.astro";
import Faq from "../components/Faq.astro";
import WhereThingsLive from "../components/compare/WhereThingsLive.astro";
import Head from "../components/page/Head.astro";
import PageHero from "../components/page/PageHero.astro";
import Related from "../components/page/Related.astro";
import { compare } from "../data/pages/compare";
import { pricing, waitlist } from "../data/site";
import Base from "../layouts/Base.astro";
import { crumbs, faq } from "../lib/seo";

const fmt = (n: number) => `$${n.toFixed(2).replace(/\.00$/, "")}`;
const total = pricing.stack.rows.reduce((sum, r) => sum + r.price, 0);
const [before, mid, after] = compare.cost.text.split(/\{total\}|\{pro\}/);
const keepWho = (apps: string) => apps.replace(/, /g, " or ");
---

<Base title={compare.title} description={compare.description} image="/og/compare.png" jsonLd={[crumbs(["Compare", "/compare"]), faq(compare.questions)]}>
  <div data-pg="compare">
    <PageHero name={compare.name} line={compare.line} lead={compare.lead} family="product" current="compare">
      <Fragment slot="cta">
        <Btn data-wl-open="nav">{waitlist.button}</Btn>
        <Btn variant="ghost" href="/pricing">See pricing</Btn>
      </Fragment>
    </PageHero>

    <section class="pg" aria-labelledby="wt-title">
      <div class="wrap">
        <Head id="wt-title" title={compare.where.title} text={compare.where.text} />
        <div data-reveal="frame">
          <WhereThingsLive />
        </div>
      </div>
    </section>

    <section class="cc pg" aria-labelledby="cc-title">
      <div class="wrap">
        <Head id="cc-title" title={compare.categories.title} text={compare.categories.text} />
        <table class="cc__table">
          <thead>
            <tr>
              <td></td>
              <th scope="col">{compare.categories.labels.moduo}</th>
              <th scope="col">{compare.categories.labels.move}</th>
              <th scope="col">{compare.categories.labels.keep}</th>
            </tr>
          </thead>
          <tbody>
            {
              compare.categories.items.map((c) => (
                <tr class="cc__row" data-reveal>
                  <th class="cc__head" scope="row">
                    <a class="cc__mod" href={c.href}>
                      <span class="cc__name">{c.module}</span>
                    </a>
                    <span class="cc__apps t-s quiet">{c.apps}</span>
                  </th>
                  <td class="cc__cell" data-label={compare.categories.labels.moduo}>
                    {c.moduo}
                  </td>
                  <td class="cc__cell muted" data-label={compare.categories.labels.move}>
                    {c.move}
                  </td>
                  <td class="cc__cell muted" data-label={compare.categories.labels.keep}>
                    Keep {"keepWho" in c ? c.keepWho : keepWho(c.apps)} if {c.keep}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <section class="bill pg" aria-labelledby="bill-title">
      <div class="wrap grid">
        <h2 class="bill__title t-xl" id="bill-title" data-split>{compare.cost.title}</h2>
        <div class="bill__body">
          <p class="t-l" data-reveal>
            {before}{fmt(total)}{mid}{fmt(pricing.stack.moduo.price)}{after}
          </p>
          <p class="t-xs quiet" data-reveal>{pricing.stack.source}</p>
          <div data-reveal>
            <Btn variant="ghost" href="/pricing" arrow>{compare.cost.link}</Btn>
          </div>
        </div>
      </div>
    </section>

    <Faq id="compare-faq" title="Before you switch." items={compare.questions} />

    <Related title="Keep reading." slugs={["pricing", "import", "integrations"]} />
  </div>
</Base>

<style>
  /* App by app: a comparison you read across. The module names its row (and opens its page). */
  .cc__table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .cc__table thead td {
    width: 22%;
  }
  .cc__table thead th {
    padding: 0 1.5rem 1rem 0;
    text-align: left;
    font-size: var(--t-xs);
    font-weight: var(--w-ui);
    letter-spacing: var(--tr-xs);
    color: var(--c-quiet);
  }
  .cc__row {
    border-top: 1px solid var(--c-line-strong);
  }
  .cc__row:last-child {
    border-bottom: 1px solid var(--c-line-strong);
  }
  .cc__head,
  .cc__cell {
    padding: 1.75rem 1.5rem 2rem 0;
    vertical-align: top;
    text-align: left;
  }
  .cc__head {
    font-weight: inherit;
  }
  .cc__mod {
    display: inline-block;
    font-size: var(--t-l);
    line-height: var(--lh-l);
    letter-spacing: var(--tr-l);
    font-weight: var(--w-display);
  }
  .cc__name {
    display: inline-block;
    transition: translate 0.5s var(--ease);
  }
  @media (hover: hover) {
    .cc__mod:hover .cc__name {
      translate: 0.25em 0;
    }
  }
  .cc__mod:focus-visible .cc__name {
    translate: 0.25em 0;
  }
  .cc__apps {
    display: block;
    margin-top: 0.375rem;
  }
  .cc__cell {
    font-size: var(--t-body);
    line-height: var(--lh-body);
  }

  .bill__title {
    grid-column: 1 / span 4;
    margin-left: -0.04em;
  }
  .bill__body {
    grid-column: 5 / span 7;
    display: grid;
    justify-items: start;
    gap: 1.25rem;
    max-width: 44rem;
  }
  .bill__body .t-l {
    font-weight: var(--w-text);
  }

  @media (max-width: 1099px) {
    .cc__table,
    .cc__table tbody,
    .cc__row,
    .cc__head,
    .cc__cell {
      display: block;
    }
    .cc__table thead {
      display: none;
    }
    .cc__row {
      padding: 1.5rem 0 1.75rem;
    }
    .cc__head,
    .cc__cell {
      padding: 0;
    }
    .cc__cell {
      margin-top: 1.25rem;
      font-size: 1rem;
    }
    .cc__cell::before {
      content: attr(data-label);
      display: block;
      margin-bottom: 0.375rem;
      font-size: var(--t-xs);
      font-weight: var(--w-ui);
      letter-spacing: var(--tr-xs);
      color: var(--c-quiet);
    }
  }
  @media (max-width: 900px) {
    .bill__title,
    .bill__body {
      grid-column: 1 / -1;
    }
    .bill__body {
      margin-top: 1.5rem;
    }
  }
</style>
