// The MCP connector's Moduo address: https://mcp.moduo.app forwards every request to the moduo-mcp
// Edge Function, so Claude shows Moduo's icon (it picks a custom connector's icon from its URL's
// domain). The function stays the connector; this Worker only forwards (src/server.ts).
//
// The top level is for `wrangler dev` (forwards to the local stack's function). Production is
// `env.production`, deployed only by .github/workflows/_deploy-mcp-proxy.yml from a release tag
// (release.yml), or a tag re-run (deploy-prod.yml, target mcp), like apps/app and apps/landing.
// Its custom domain is declared here, so a deploy keeps it (the first one creates the DNS record
// in the moduo.app zone).
{
  "name": "moduo-mcp-proxy-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    // The function's own URL. Locally, the shared stack's.
    "UPSTREAM": "http://127.0.0.1:54321/functions/v1/moduo-mcp"
  },
  "observability": { "enabled": true },
  "env": {
    "production": {
      "name": "moduo-mcp-proxy",
      // One public address: the custom domain.
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "mcp.moduo.app", "custom_domain": true }],
      "vars": {
        "UPSTREAM": "https://wtoonrvuqumihpkbvwvs.supabase.co/functions/v1/moduo-mcp"
      }
    }
  }
}
