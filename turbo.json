{
  "$schema": "https://turborepo.com/schema.json",
  "agentGuidance": false,
  "envMode": "loose",
  "remoteCache": {
    "signature": true
  },
  "futureFlags": {
    "longerSignatureKey": true
  },
  "globalDependencies": ["tsconfig.base.json", "bunfig.toml", ".bun-version"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "build:staging": {
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "outputs": []
    },
    "lint:tw": {
      "outputs": []
    },
    "lint:boundaries": {
      "outputs": []
    },
    "lint:css": {
      "outputs": []
    },
    "size": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!dist/**",
        "$TURBO_ROOT$/scripts/check-bundle-size.ts",
        "$TURBO_ROOT$/supabase/functions/_shared/**"
      ],
      "outputs": ["dist/web/**"]
    },
    "test": {
      "outputs": []
    },
    "@moduo/landing#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/public/favicon*",
        "$TURBO_ROOT$/apps/app/public/apple-touch-icon.png",
        "$TURBO_ROOT$/release-notes/**"
      ],
      "outputs": ["dist/**"]
    },
    "@moduo/landing#build:staging": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/public/favicon*",
        "$TURBO_ROOT$/apps/app/public/apple-touch-icon.png",
        "$TURBO_ROOT$/release-notes/**"
      ],
      "outputs": ["dist/**"]
    },
    "//#typecheck:root": {
      "inputs": ["tsconfig.json", "scripts/**", "apps/app/src/components/ui/moduo-mark-path.ts"],
      "outputs": []
    },
    "//#lint:js": {
      "inputs": ["$TURBO_DEFAULT$", "!**/.turbo/**"],
      "outputs": []
    },
    "//#lint:ratchets": {
      "cache": false
    },
    "//#lint:notes": {
      "inputs": [
        ".changes/**",
        "release-notes/**",
        "scripts/release/**",
        "supabase/migrations/**",
        "supabase/functions/**"
      ],
      "outputs": []
    },
    "//#test:scripts": {
      "inputs": [
        "scripts/**",
        ".claude/hooks/guard-release*",
        ".claude/hooks/guard-git*",
        "VERSION",
        "brand/**",
        "apps/app/src/**",
        "apps/app/public/**",
        ".changes/**",
        "release-notes/**",
        "CHANGELOG.md",
        "supabase/migrations/**",
        "supabase/functions/**"
      ],
      "outputs": []
    }
  }
}
