{
  "framework": null,
  "installCommand": "bun install --frozen-lockfile",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist/web",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "staging-landing": true,
      "prod-landing": true,
      "staging-app": true,
      "prod-app": true
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.posthog.com; frame-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/book",
      "has": [{ "type": "host", "value": "staging.moduo.app" }],
      "destination": "/app.html"
    },
    {
      "source": "/book/:path*",
      "has": [{ "type": "host", "value": "staging.moduo.app" }],
      "destination": "/app.html"
    },
    {
      "source": "/book",
      "has": [{ "type": "host", "value": "moduo.app" }],
      "destination": "/app.html"
    },
    {
      "source": "/book/:path*",
      "has": [{ "type": "host", "value": "moduo.app" }],
      "destination": "/app.html"
    },
    {
      "source": "/book",
      "has": [{ "type": "host", "value": "www.moduo.app" }],
      "destination": "/app.html"
    },
    {
      "source": "/book/:path*",
      "has": [{ "type": "host", "value": "www.moduo.app" }],
      "destination": "/app.html"
    },
    {
      "source": "/manifesto",
      "has": [{ "type": "host", "value": "moduo.app" }],
      "destination": "/manifesto.html"
    },
    {
      "source": "/manifesto",
      "has": [{ "type": "host", "value": "www.moduo.app" }],
      "destination": "/manifesto.html"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "host", "value": "moduo.app" }],
      "destination": "/privacy.html"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "host", "value": "www.moduo.app" }],
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "has": [{ "type": "host", "value": "moduo.app" }],
      "destination": "/terms.html"
    },
    {
      "source": "/terms",
      "has": [{ "type": "host", "value": "www.moduo.app" }],
      "destination": "/terms.html"
    },
    {
      "source": "/dpa",
      "has": [{ "type": "host", "value": "moduo.app" }],
      "destination": "/dpa.html"
    },
    {
      "source": "/dpa",
      "has": [{ "type": "host", "value": "www.moduo.app" }],
      "destination": "/dpa.html"
    },
    {
      "source": "/aup",
      "has": [{ "type": "host", "value": "moduo.app" }],
      "destination": "/aup.html"
    },
    {
      "source": "/aup",
      "has": [{ "type": "host", "value": "www.moduo.app" }],
      "destination": "/aup.html"
    },
    {
      "source": "/((?!assets|static/|favicon|manifest|sw\\.|app\\.html|landing\\.html).*)",
      "destination": "/index.html"
    }
  ]
}
