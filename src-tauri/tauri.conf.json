{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moduo",
  "version": "0.1.0",
  "identifier": "com.moduo.desktop",
  "build": {
    "beforeBuildCommand": "bun run build:web",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Moduo",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  }
}
