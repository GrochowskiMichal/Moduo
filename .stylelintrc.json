{
  "extends": ["stylelint-config-standard"],
  "plugins": ["stylelint-declaration-strict-value"],
  "ignoreFiles": ["node_modules/**", "dist/**", "src-tauri/**", "src/styles/tokens.css"],
  "defaultSeverity": "warning",
  "rules": {
    "color-no-hex": [
      true,
      {
        "severity": "error"
      }
    ],
    "scale-unlimited/declaration-strict-value": [
      ["/color$/", "fill", "stroke", "background-color"],
      {
        "ignoreValues": [
          "transparent",
          "currentColor",
          "inherit",
          "none",
          "initial",
          "unset",
          "/^var\\(--/"
        ],
        "severity": "error"
      }
    ],
    "declaration-property-value-disallowed-list": [
      {
        "writing-mode": ["/^vertical/", "/^sideways/"],
        "text-orientation": ["/.*/"],
        "transform": ["/rotate\\(\\s*-?(90|270)deg/", "/rotate\\(\\s*-?0?\\.(25|75)turn/"],
        "rotate": ["/^-?(90|270)deg/", "/^-?0?\\.(25|75)turn/"],
        "font-variant": ["/small-caps/", "/petite-caps/", "/unicase/", "/titling-caps/"],
        "font-variant-caps": ["/.*caps/", "unicase"],
        "text-transform": ["uppercase", "capitalize"]
      },
      {
        "severity": "error",
        "message": "DS-6: text is never rotated (call 46a) and small caps / capitals are for fixed chrome through <Eyebrow> only, never in CSS (call 40). Turn an icon in TSX on the icon itself."
      }
    ],
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "theme",
          "layer",
          "variants",
          "responsive",
          "screen",
          "custom-variant"
        ]
      }
    ],
    "no-descending-specificity": null,
    "selector-class-pattern": null,
    "keyframes-name-pattern": null,
    "alpha-value-notation": null,
    "color-function-notation": null,
    "import-notation": null,
    "shorthand-property-no-redundant-values": null,
    "declaration-block-no-redundant-longhand-properties": null,
    "media-feature-range-notation": null,
    "selector-not-notation": null,
    "value-keyword-case": null,
    "property-no-vendor-prefix": null,
    "selector-no-vendor-prefix": null,
    "font-family-name-quotes": null,
    "comment-empty-line-before": null,
    "rule-empty-line-before": null,
    "declaration-empty-line-before": null,
    "at-rule-empty-line-before": null,
    "no-duplicate-selectors": null,
    "block-no-empty": null
  },
  "overrides": [
    {
      "files": ["src/global.css", "src/features/timetracking/**/*.css"],
      "rules": {
        "color-no-hex": [
          true,
          {
            "severity": "warning"
          }
        ],
        "scale-unlimited/declaration-strict-value": [
          ["/color$/", "fill", "stroke", "background-color"],
          {
            "ignoreValues": [
              "transparent",
              "currentColor",
              "inherit",
              "none",
              "initial",
              "unset",
              "/^var\\(--/"
            ],
            "severity": "warning"
          }
        ]
      }
    }
  ]
}
