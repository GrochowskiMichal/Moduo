{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./src/*"],
      "@contracts/*": ["./supabase/functions/_shared/contracts/*"]
    }
  },
  "include": [
    "src",
    "rsbuild.config.ts",
    "playwright.config.ts",
    "rstest.config.ts",
    "supabase/functions/_shared/contracts",
    "supabase/functions/_shared/account-erasure.ts",
    "supabase/functions/_shared/account-erasure.test.ts",
    "supabase/functions/_shared/analytics-forget.ts",
    "supabase/functions/_shared/analytics-forget.test.ts",
    "supabase/functions/_shared/app-origin.ts",
    "supabase/functions/_shared/app-origin.test.ts",
    "supabase/functions/_shared/client-ip.ts",
    "supabase/functions/_shared/client-ip.test.ts",
    "supabase/functions/_shared/escape.ts",
    "supabase/functions/_shared/escape.test.ts",
    "supabase/functions/_shared/posthog-erasure.ts",
    "supabase/functions/_shared/posthog-erasure.test.ts",
    "supabase/functions/send-workspace-invite/email.ts",
    "supabase/functions/send-workspace-invite/email.test.ts"
  ],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
