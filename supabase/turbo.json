{
  "$schema": "https://turborepo.com/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/src/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/src/**",
        "$TURBO_ROOT$/apps/app/public/**",
        "$TURBO_ROOT$/apps/app/package.json",
        "$TURBO_ROOT$/bun.lock"
      ]
    }
  }
}
