# Local Edge Function secrets for `bun run local:functions`.
# Copy to supabase/functions/.env (gitignored). Test-mode values only.
# SUPABASE_URL and the service key are injected by the CLI automatically.
# Prices are found by lookup_key, so there are no STRIPE_PRICE_* secrets
# (docs/decisions/billing.md, 2026-10-06).
STRIPE_SECRET_KEY=sk_test_...
PUBLIC_APP_URL=http://127.0.0.1:8081
