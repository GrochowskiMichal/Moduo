# Local Edge Function secrets for `bun run local:functions`.
# Copy to supabase/functions/.env (gitignored). Test-mode values only.
# SUPABASE_URL / keys are injected by the CLI automatically.
STRIPE_SECRET_KEY=sk_test_...
# From `bun run local:stripe` (prints a whsec_ for this machine's listener)
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TEAM_MONTHLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...
STRIPE_PRICE_FOUNDERS=price_...
PUBLIC_APP_URL=http://127.0.0.1:8081
