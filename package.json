{
  "name": "moduo2.0",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev:web",
    "dev:web": "./node_modules/.bin/rsbuild dev --host 127.0.0.1 --port 8081",
    "preview:web": "./node_modules/.bin/rsbuild preview --host 127.0.0.1 --port 8081",
    "dev:desktop": "zsh -lc 'set -a; [[ -f .env.local ]] && source .env.local; set +a; ./node_modules/.bin/rsbuild dev --host 127.0.0.1 --port 8081 & WEB_PID=$!; trap \"kill $WEB_PID\" EXIT INT TERM; node ./node_modules/@tauri-apps/cli/tauri.js dev'",
    "dev:desktop:signed": "bun run build:desktop:signed:debug && open ./src-tauri/target/debug/bundle/macos/moduo.app",
    "build:web": "rsbuild build",
    "build:desktop": "node ./node_modules/@tauri-apps/cli/tauri.js build",
    "build:desktop:signed:debug": "bash ./scripts/tauri-signed-build.sh debug",
    "build:desktop:signed:release": "bash ./scripts/tauri-signed-build.sh release",
    "verify:desktop:signature": "codesign -d -r- ./src-tauri/target/release/bundle/macos/moduo.app/Contents/MacOS/moduo && codesign -vv ./src-tauri/target/release/bundle/macos/moduo.app",
    "storybook": "sb dev -p 6006",
    "build-storybook": "sb build",
    "storybook:gen": "bun ./scripts/generate-storybook-stories.ts",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:tw": "bun ./scripts/check-arbitrary-tw.ts",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest --maxWorkers=1",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/cal-sans": "^5.2.3",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/source-serif-pro": "^5.2.5",
    "@lexical/code": "^0.40.0",
    "@lexical/history": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/selection": "^0.40.0",
    "@lexical/yjs": "^0.40.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-router": "^1.132.24",
    "@tauri-apps/api": "^2.8.0",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.34.3",
    "lexical": "^0.40.0",
    "lucide-react": "^0.552.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.13",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@rsbuild/core": "^1.5.13",
    "@rsbuild/plugin-react": "^1.4.1",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/cli": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/testing-library": "^0.2.2",
    "@tauri-apps/cli": "^2.8.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.10",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "storybook": "8.6.14",
    "stylelint": "^17.11.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.2",
    "vitest": "^4.0.18"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
