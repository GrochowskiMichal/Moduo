    "@subframe/core": "^1.155.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/postcss": "4.3.3",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "2.12.1",
    "@tauri-apps/plugin-process": "2.4.0",
    "@tauri-apps/plugin-updater": "2.13.1",
    "@xyflow/react": "^12.12.0",
    "chrono-node": "^2.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "14.0.0",
    "ical.js": "^2.2.1",
    "lexical": "0.52.0",
    "lucide-react": "1.52.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.438.2",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "^4.14.2",
    "remark-gfm": "^4",
