{
  "name": "moduo2.0",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "types": ".design-sync/ds-types/index.d.ts",
  "scripts": {
    "start": "bun run dev:web",
    "dev:web": "MODUO_TARGET=web ./node_modules/.bin/rsbuild dev --host 127.0.0.1 --port 8081",
    "preview:web": "MODUO_TARGET=web ./node_modules/.bin/rsbuild preview --host 127.0.0.1 --port 8081",
    "dev:desktop": "zsh -lc 'set -a; [[ -f .env.local ]] && source .env.local; set +a; MODUO_TARGET=desktop ./node_modules/.bin/rsbuild dev --host 127.0.0.1 --port 8081 & WEB_PID=$!; trap \"kill $WEB_PID\" EXIT INT TERM; node ./node_modules/@tauri-apps/cli/tauri.js dev'",
    "dev:desktop:signed": "bun run build:desktop:signed:debug && open ./src-tauri/target/debug/bundle/macos/moduo.app",
    "build:web": "MODUO_TARGET=web rsbuild build",
    "build:desktop": "MODUO_TARGET=desktop node ./node_modules/@tauri-apps/cli/tauri.js build",
    "build:desktop:signed:debug": "bash ./scripts/tauri-signed-build.sh debug",
    "build:desktop:signed:release": "bash ./scripts/tauri-signed-build.sh release",
    "verify:desktop:signature": "codesign -d -r- ./src-tauri/target/release/bundle/macos/moduo.app/Contents/MacOS/moduo && codesign -vv ./src-tauri/target/release/bundle/macos/moduo.app",
    "icon:liquid": "bun scripts/icons/build-liquid-icon.ts",
    "storybook": "sb dev -p 6006",
    "build-storybook": "sb build",
    "storybook:gen": "bun ./scripts/generate-storybook-stories.ts",
    "typecheck": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:tw": "bun ./scripts/check-arbitrary-tw.ts",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest --maxWorkers=1",
    "verify": "bun run typecheck && bun run lint:tw && bun run lint:css && bun run test",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource/cal-sans": "^5.2.3",
    "@fontsource/geist-mono": "^5.2.7",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/nunito": "^5.2.7",
    "@fontsource/source-serif-pro": "^5.2.5",
    "@lexical/code": "^0.40.0",
    "@lexical/headless": "^0.40.0",
    "@lexical/history": "^0.40.0",
    "@lexical/link": "^0.40.0",
    "@lexical/list": "^0.40.0",
    "@lexical/markdown": "^0.40.0",
    "@lexical/react": "^0.40.0",
    "@lexical/rich-text": "^0.40.0",
    "@lexical/selection": "^0.40.0",
    "@lexical/utils": "^0.40.0",
    "@lexical/yjs": "^0.40.0",
    "@subframe/core": "^1.155.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.3.0",
    "@tanstack/react-router": "^1.169.2",
    "@tauri-apps/api": "^2.11.0",
    "@xyflow/react": "^12.10.2",
    "chrono-node": "^2.9.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "ical.js": "^2.2.1",
    "lexical": "^0.40.0",
    "lucide-react": "^0.552.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.373.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.0",
    "react-markdown": "^9",
    "react-resizable-panels": "^4.11.1",
    "remark-gfm": "^4",
    "rrule": "^2.8.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "4.1.13",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@resvg/resvg-js": "^2.6.2",
    "@rsbuild/core": "^1.7.5",
    "@rsbuild/plugin-react": "^1.4.6",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-interactions": "8.6.14",
    "@storybook/cli": "8.6.14",
    "@storybook/react-vite": "8.6.14",
    "@storybook/testing-library": "^0.2.2",
    "@tauri-apps/cli": "^2.11.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "~19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^28.1.0",
    "storybook": "8.6.14",
    "stripe": "^22.1.1",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.11.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.6"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  }
}
