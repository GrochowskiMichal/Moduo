{
  "name": "moduo2.0",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "infra/*",
    "e2e",
    "supabase"
  ],
  "types": ".design-sync/ds-types/index.d.ts",
  "scripts": {
    "start": "bun run dev:web",
    "dev:web": "bun run --cwd apps/app dev",
    "preview:web": "bun run --cwd apps/app preview",
    "preview:landing": "bun scripts/preview-landing.ts",
    "dev:desktop": "zsh -lc 'set -a; [[ -f .env.local ]] && source .env.local; set +a; (cd apps/app && export MODUO_TARGET=desktop && exec ../../node_modules/.bin/rsbuild dev --host 127.0.0.1 --port 8081) & WEB_PID=$!; trap \"kill $WEB_PID\" EXIT INT TERM; cd apps/desktop && node ../../node_modules/@tauri-apps/cli/tauri.js dev'",
    "dev:desktop:signed": "bun run build:desktop:signed:debug && open ./apps/desktop/src-tauri/target/debug/bundle/macos/moduo.app",
    "build:web": "bun run --cwd apps/app build",
    "build:desktop:web": "bun run --cwd apps/app build:desktop",
    "build:desktop": "bun run --cwd apps/desktop build",
    "build:desktop:signed:debug": "bash ./scripts/tauri-signed-build.sh debug",
    "build:desktop:signed:release": "bash ./scripts/tauri-signed-build.sh release",
    "verify:desktop:signature": "codesign -d -r- ./apps/desktop/src-tauri/target/release/bundle/macos/moduo.app/Contents/MacOS/moduo && codesign -vv ./apps/desktop/src-tauri/target/release/bundle/macos/moduo.app",
    "brand:export": "bun scripts/brand/export.ts",
    "icon:liquid": "bun scripts/icons/build-liquid-icon.ts",
    "db:reconcile": "bun scripts/db-reconcile.ts",
    "db:preflight": "bun scripts/db-contract-preflight.ts",
    "db:test": "bun scripts/db-test.ts",
    "db:types": "bun scripts/db-types.ts",
    "db:types:local": "bun scripts/db-types.ts --local",
    "functions:reconcile": "bun scripts/functions-reconcile.ts",
    "local:up": "bash scripts/local/stack.sh up",
    "local:down": "bash scripts/local/stack.sh down",
    "local:reset": "bash scripts/local/stack.sh reset",
    "local:snapshot": "bash scripts/local/stack.sh snapshot",
    "local:status": "bash scripts/local/stack.sh status",
    "local:functions": "bash scripts/local/stack.sh functions",
    "local:stripe": "docker run --rm -it -v \"$HOME/.config/stripe:/root/.config/stripe\" stripe/stripe-cli listen --print-json",
    "env:local": "bun scripts/local/env.ts local",
    "env:cloud": "bun scripts/local/env.ts cloud",
    "storybook": "bun run --cwd apps/storybook dev",
    "build-storybook": "bun run --cwd apps/storybook build",
    "storybook:gen": "cd apps/app && bun ../../scripts/generate-storybook-stories.ts",
    "typecheck": "turbo run typecheck typecheck:root",
    "typecheck:root": "bun check",
    "lint:js": "bun scripts/bun-lint.ts --report-unused-disable-directives && bun fmt --check",
    "lint:css": "turbo run lint:css",
    "lint:tw": "turbo run lint:tw",
    "lint:boundaries": "turbo run lint:boundaries",
    "size": "turbo run size",
    "lint:notes": "bun scripts/release/check-notes.ts",
    "lint:ratchets": "bun scripts/ci/ratchets.ts",
    "build:notes-doc": "bun ./scripts/build-notes-doc.ts",
    "format": "bun fmt",
    "format:fix": "bun scripts/bun-lint.ts --fix && bun fmt",
    "test": "turbo run test test:scripts",
    "test:scripts": "rstest -c scripts/rstest.config.ts",
    "test:watch": "bun run --cwd apps/app test:watch",
    "verify": "turbo run typecheck typecheck:root lint:js lint:tw lint:boundaries lint:css lint:notes lint:ratchets size test test:scripts",
    "e2e": "bun run --cwd e2e e2e",
    "perf:seed": "bun scripts/perf/seed-tasks-10k.ts",
    "perf": "bun scripts/perf/seed-tasks-10k.ts && bun run --cwd e2e perf"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@rstest/core": "^0.12.3",
    "oxc-parser": "0.127.0",
    "stripe": "23.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-declaration-strict-value": "^1.12.1",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  }
}
